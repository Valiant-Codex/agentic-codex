#!/usr/bin/env bash
# dream — nightly per-agent memory consolidation ("dreaming").
#
# Two phases, split strictly by blast radius:
#   Phase A (mirror, always): deterministically mirror the agent's Claude Code
#     runtime auto-memory (~/.claude/projects/-home-<user>/memory) into its brain
#     repo at memory/auto/, and commit. Pure copy — no LLM, no judgment, no risk.
#   Phase B (distil, only with --distill): a tightly-scoped headless `claude -p`
#     run that promotes gate-passing durable facts into memory/distilled-memory.md
#     and writes skill/identity SUGGESTIONS (never applied) to memory/dream-log.md.
#     ENFORCEMENT LIVES HERE, NOT IN THE PROMPT: only memory/ is committed; any
#     change the run makes outside memory/ is reverted before exit. So the dream can
#     refine memory but can NEVER alter SOUL/OPERATING/skills/config — capability and
#     identity changes go only through the human-gated `agent-audit` skill.
#
# Runs as root (or durin+sudo); all per-user work via runuser so ownership and the
# per-user gh credential are honoured. Commits are prefixed "[dream]" and authored as
# the agent, so they are greppable and mass-revertible.
#
# Invoked per-agent by dream@<user>.timer (~5am, staggered), DISABLED by default
# (opt-in, like OpenClaw's dreaming). Canonical source: Valiant-Codex/infra.
set -uo pipefail

usage(){ echo "usage: dream <agent-user> [--distill]" >&2; exit 2; }
U="${1:-}"; [ -n "$U" ] || usage
MODE="mirror"; [ "${2:-}" = "--distill" ] && MODE="distill"
TODAY="$(date +%F)"
log(){ echo "$(date -Is) dream/$U: $*"; }
run(){ runuser -u "$U" -- bash -lc "$1"; }

HOME_DIR="$(getent passwd "$U" | cut -d: -f6)" || { log "no such user"; exit 1; }
BASE="$HOME_DIR/github/valiant-codex"
BRAIN="$(ls -d "$BASE"/kb-agent-*-"$U" 2>/dev/null | head -1)"
[ -n "$BRAIN" ] && [ -d "$BRAIN/.git" ] || { log "brain repo not found under $BASE"; exit 1; }
AUTOMEM="$HOME_DIR/.claude/projects/-home-$U/memory"

# ---------- Phase A: mirror (deterministic) ----------
if [ -d "$AUTOMEM" ]; then
  DEST="$BRAIN/memory/auto"
  run "mkdir -p '$DEST' && rsync -a --delete '$AUTOMEM/' '$DEST/'"
  run "cd '$BRAIN' && git add memory/auto"
  if run "cd '$BRAIN' && git diff --cached --quiet"; then
    log "mirror: no changes"
  else
    run "cd '$BRAIN' && git commit -q -m '[dream] mirror runtime auto-memory ($TODAY)' && git push -q"
    log "mirror: committed + pushed"
  fi
else
  log "mirror: no auto-memory at $AUTOMEM (skip)"
fi

[ "$MODE" = "distill" ] || { log "done (mirror-only)"; exit 0; }

# ---------- Phase B: distil (LLM, tightly scoped; enforcement is below, not in the prompt) ----------
PROMPT="/usr/local/share/dream/consolidate-prompt.md"
[ -f "$PROMPT" ] || { log "distil: prompt $PROMPT missing (skip)"; exit 0; }

# Capture pre-run tracked churn (e.g. runtime-dirty deploy/topics.tsv) so the enforcement
# below restores it — we revert only what THIS run changes, never pre-existing runtime state.
PATCH="/tmp/dream-prerun-$U.patch"
run "cd '$BRAIN' && git diff > '$PATCH'"

# Headless, scoped to Read/Edit/Write + git only; no network, no arbitrary shell, no subagents.
run "cd '$BRAIN' && export PATH=\$HOME/.local/bin:\$HOME/.local/node/bin:\$PATH && \
  claude -p \"\$(cat '$PROMPT')\" \
    --allowedTools 'Read,Edit,Write,Bash(git *)' \
    --disallowedTools 'WebFetch,WebSearch,Bash,Task' \
    --permission-mode acceptEdits >/dev/null 2>&1 || true"

# ENFORCEMENT: stage + commit ONLY memory/; then hard-revert anything the run left
# outside memory/ (SOUL/OPERATING/skills/config/etc). The wrapper — not the prompt —
# is the guardrail, so a compromised or drifting run cannot change identity/capability.
run "cd '$BRAIN' && git add memory/"
if run "cd '$BRAIN' && git diff --cached --quiet"; then
  log "distil: no memory changes"
else
  run "cd '$BRAIN' && git commit -q -m '[dream] distil memory + suggestions ($TODAY)'"
  log "distil: committed memory changes"
fi
LEFT="$(run "cd '$BRAIN' && git status --porcelain")"
if [ -n "$LEFT" ]; then
  log "distil: restoring tree (revert the run's out-of-scope edits; preserve pre-run runtime churn):"
  echo "$LEFT" | sed 's/^/    /'
  # Revert everything outside the memory commit, then re-apply the pre-run churn patch so
  # legitimate runtime-dirty files (e.g. deploy/topics.tsv) are left exactly as we found them.
  run "cd '$BRAIN' && git checkout -- . && git clean -fdq && { [ -s '$PATCH' ] && git apply '$PATCH' 2>/dev/null || true; }"
fi
run "rm -f '$PATCH'"
run "cd '$BRAIN' && git push -q" 2>/dev/null && log "distil: pushed" || log "distil: nothing to push"
log "done (distil)"
