#!/usr/bin/env bash
# agentic-monitor — host-level health check + heartbeat to an external dead-man's switch.
#
# The single monitoring component (see the Agentic Codex docs (monitoring.md)). Runs on the HOST (systemd timer,
# ~5 min), OUTSIDE Docker, so it survives a Dokploy/Docker failure. Each run does a few binary
# local checks, then pings healthchecks.io:
#   - all ok            -> ping <HC_URL>              (heartbeat)
#   - problem, 1st time -> ping <HC_URL> (body notes it, no alarm yet — hysteresis)
#   - problem, 2nd time -> ping <HC_URL>/fail (body = detail)   -> healthchecks alarms you
#   - script/timer/box/network dead -> no ping at all -> healthchecks alarms on missed beat
# Fail-safe by design: silence is the alarm. Keep this script trivial.
#
# Config (NOT in git — secret-ish capability URL): /etc/agentic-monitor.env, mode 600:
#   HC_URL=https://hc-ping.com/<uuid>
#   DISK_MAX=90                         # optional, percent
#   MONITOR_EXCLUDE_CONTAINERS="" # optional, substring match, space-separated (known-noise)
# Dry run (no ping): agentic-monitor --dry-run
set -uo pipefail

DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1

CONF=/etc/agentic-monitor.env
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
: "${HC_URL:?HC_URL not set in $CONF}"
DISK_MAX="${DISK_MAX:-90}"
MONITOR_EXCLUDE_CONTAINERS="${MONITOR_EXCLUDE_CONTAINERS:-}"
MONITOR_EXCLUDE_UNITS="${MONITOR_EXCLUDE_UNITS:-}"
MONITOR_EXPECT_CONTAINERS="${MONITOR_EXPECT_CONTAINERS:-}"   # substrings that MUST be running (catch exited/missing)
MONITOR_HTTP_CHECKS="${MONITOR_HTTP_CHECKS:-}"               # "label=url ..."; alarm only if no HTTP response at all
MONITOR_MEM_MIN_PCT="${MONITOR_MEM_MIN_PCT:-5}"             # alarm if available memory < this % of total
STATE=/run/agentic-monitor.state       # ephemeral (cleared on reboot — fine)

# Agents auto-discovered (any user with a ~/github/<org>/kb-agent-<role>-<name> brain);
# override with AGENTS="user1 user2" in the env file.
discover_agents() {
  local h u
  for h in /home/*; do
    [ -d "$h" ] || continue
    u="$(basename "$h")"
    compgen -G "$h/github/*/kb-agent-*-*/" >/dev/null 2>&1 && echo "$u"
  done
}
AGENTS="${AGENTS:-$(discover_agents)}"

problems=()

# 1) Docker: daemon up, and no unhealthy/restarting containers (minus known-noise excludes).
if command -v docker >/dev/null 2>&1; then
  if ! timeout 20 docker info >/dev/null 2>&1; then
    problems+=("docker-daemon-unresponsive")
  else
    bad=$(timeout 20 docker ps --format '{{.Names}} {{.Status}}' 2>/dev/null \
          | grep -iE 'unhealthy|restarting' | awk '{print $1}')
    for x in $MONITOR_EXCLUDE_CONTAINERS; do bad=$(printf '%s\n' "$bad" | grep -vF -- "$x"); done
    bad=$(printf '%s' "$bad" | grep -v '^$' | paste -sd, -)
    [ -n "$bad" ] && problems+=("containers:$bad")
    # critical containers that must be present+running (catches exited/vanished, incl. no-healthcheck ones)
    running=$(timeout 20 docker ps --format '{{.Names}}' 2>/dev/null)
    for want in $MONITOR_EXPECT_CONTAINERS; do
      printf '%s\n' "$running" | grep -qF "$want" || problems+=("missing-container:$want")
    done
  fi
fi

# 2) Disk usage on /.
use=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9')
[ -n "$use" ] && [ "$use" -ge "$DISK_MAX" ] && problems+=("disk:${use}%")

# 2b) Available memory below threshold (catches memory pressure / OOM risk).
memline=$(free | awk '/^Mem:/{print $2, $7}')
mt=${memline% *}; ma=${memline#* }
if [ -n "${mt:-}" ] && [ "${mt:-0}" -gt 0 ] 2>/dev/null; then
  mpct=$(( ma * 100 / mt ))
  [ "$mpct" -lt "$MONITOR_MEM_MIN_PCT" ] && problems+=("mem-avail:${mpct}%")
fi

# 2c) HTTP reachability (e.g. traefik/dokploy) — alarm only if nothing responds at all.
# -k skips TLS verify: intended for LOCAL liveness (http://localhost) — don't point this at a
# remote HTTPS endpoint expecting cert validation.
for chk in $MONITOR_HTTP_CHECKS; do
  lbl="${chk%%=*}"; url="${chk#*=}"
  code=$(curl -sk -o /dev/null -w '%{http_code}' -m 8 "$url" 2>/dev/null || echo 000)
  { [ -z "$code" ] || [ "$code" = "000" ]; } && problems+=("http-down:$lbl")
done

# 3) Failed systemd system units (minus known-noise excludes).
fu=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}')
for x in $MONITOR_EXCLUDE_UNITS; do fu=$(printf '%s\n' "$fu" | grep -vF "$x"); done
fu=$(printf '%s' "$fu" | grep -v '^$' | paste -sd, -)
[ -n "$fu" ] && problems+=("failed-units:$fu")

# 4) kb-sync: not failed, and ran recently (timer = 15 min; stale if > 40 min).
if systemctl is-failed --quiet kb-sync.service; then problems+=("kb-sync:failed"); fi
last=$(systemctl show kb-sync.service -p ExecMainExitTimestamp --value 2>/dev/null)
if [ -n "$last" ]; then
  lts=$(date -d "$last" +%s 2>/dev/null || echo 0)
  now=$(date +%s)
  [ "$lts" -gt 0 ] && [ $((now - lts)) -gt 2400 ] && problems+=("kb-sync:stale($(((now-lts)/60))m)")
fi

# 5) Agent topic sessions: every ENABLED key in each agent's topics.tsv must be active.
# Repo resolution must match bin/claude-topic's exactly (same username-pinned glob,
# same refuse-not-guess rule on ambiguity) — kept in sync by hand, there is no
# shared library between this host-level script and the per-agent wrapper.
# Diverging here would make a hijacked/broken repo LOOK healthy: if the wrapper
# refuses to run but this check keeps resolving something else (or nothing, or a
# registry-less decoy), the monitor pings green while the agent is silently down —
# found and fixed 2026-07-26: an earlier version alarmed only on >1 candidates, but
# 0 candidates (repo simply moved/renamed away — the cheapest version of this
# attack) and "repo resolved but topics.tsv missing" both fell through to a silent
# `exit 0`. Sentinels are prefixed with `!`, a character `require_valid_key` never
# allows in a real topic key, so a topic coincidentally named e.g. `NO-REPO` can't
# be confused with one of these.
# `bash -lc` (login shell) sources the agent's own (agent-owned) ~/.profile/
# ~/.bash_profile — found and fixed 2026-07-26: a planted shell function
# (`systemctl() { return 0; }`) there silently neutralizes every is-enabled/
# is-active check below, regardless of repo resolution. `--noprofile --norc` plus
# an explicit PATH removes that entirely.
for u in $AGENTS; do
  dead=$(runuser -u "$u" -- env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash --noprofile --norc -c '
    export XDG_RUNTIME_DIR=/run/user/$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
    cands="$(ls -d ~/github/*/kb-agent-*-"$(id -un)"/ 2>/dev/null)"
    cnt="$(printf "%s" "$cands" | grep -c . || true)"
    if [ "${cnt:-0}" -eq 0 ]; then echo "!NO-REPO"; exit 0; fi
    if [ "${cnt:-0}" -gt 1 ]; then echo "!AMBIGUOUS-REPO"; exit 0; fi
    b="$cands"
    reg="${b}deploy/topics.tsv"; d=""
    [ -f "$reg" ] || { echo "!NO-REGISTRY"; exit 0; }
    # If the user manager is unreachable (linger off, session gone), every is-enabled below fails and
    # the loop reports nothing — i.e. "all sessions dead" would look identical to "all healthy".
    systemctl --user show-environment >/dev/null 2>&1 || { echo "!USERBUS-UNREACHABLE"; exit 0; }
    while read -r k _; do
      case "$k" in ""|\#*) continue;; esac
      # only expect ENABLED topics: a stopped/removed one is disabled -> intentionally down, skip it
      systemctl --user is-enabled --quiet "claude-topic@$k.service" 2>/dev/null || continue
      systemctl --user is-active --quiet "claude-topic@$k.service" || d="$d $k"
    done < "$reg"
    echo "$d"' 2>/dev/null | tr -s ' ' | sed 's/^ *//;s/ *$//')
  case "$dead" in
    '!USERBUS-UNREACHABLE') problems+=("agent-session-unreachable[$u]") ;;
    '!NO-REPO')              problems+=("agent-repo-missing[$u]") ;;
    '!AMBIGUOUS-REPO')       problems+=("agent-repo-ambiguous[$u]") ;;
    '!NO-REGISTRY')          problems+=("agent-registry-missing[$u]") ;;
    '') ;;
    *) problems+=("topics-down[$u]:$(echo "$dead" | tr ' ' ',')") ;;
  esac
done

# --- Decide + ping (with 2-cycle hysteresis via STATE) ---
detail=$(IFS='; '; echo "${problems[*]:-}")
prev=""; [ -r "$STATE" ] && prev=$(cat "$STATE" 2>/dev/null)

ping() { # $1 = url suffix (""|/fail), $2 = body
  [ "$DRY" = 1 ] && { echo "[dry-run] would ping ${HC_URL}${1}  body='${2}'"; return; }
  curl -fsS -m 15 --retry 3 --data-raw "$2" "${HC_URL}${1}" -o /dev/null || true
}

if [ ${#problems[@]} -eq 0 ]; then
  : > "$STATE"
  ping "" "ok $(date -Is)"
elif [ -n "$prev" ]; then
  ping "/fail" "$detail"                 # confirmed (2nd consecutive cycle) -> alarm
  echo "$detail" > "$STATE"
else
  ping "" "pending: $detail"             # 1st occurrence -> heartbeat only, mark pending
  echo "$detail" > "$STATE"
fi

[ "$DRY" = 1 ] && { echo "problems: ${detail:-none}"; }
exit 0
