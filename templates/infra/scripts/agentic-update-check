#!/usr/bin/env bash
# agentic-update-check — weekly INFORMATIONAL report of available updates (OS + Dokploy).
# Not a failure monitor (that's agentic-monitor). Pings UPDATE_HC_URL (a healthchecks.io check) —
# /fail with the summary when something is updatable (so it notifies you), success otherwise.
# Run by agentic-update-check.timer (weekly). Container image updates are handled git-natively by
# Renovate on the infra repo (PRs), not here.
set -uo pipefail
CONF=/etc/agentic-monitor.env
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

updates=0

# --- OS ---
apt-get update -qq >/dev/null 2>&1 || true
upg=$(apt list --upgradable 2>/dev/null | grep -c '/'); upg=${upg:-0}
sec=$(apt list --upgradable 2>/dev/null | grep -ci -E 'security|-esm-'); sec=${sec:-0}
reboot=no; [ -f /var/run/reboot-required ] && reboot=yes
# Alarm only on actionable items: pending SECURITY updates (unattended-upgrades should auto-apply — if
# still pending it's worth flagging). upgradable-count and reboot-required are REPORTED, not alarmed.
[ "${sec:-0}" -gt 0 ] && updates=1
os="OS: ${upg} upgradable (${sec} security), reboot-required=${reboot}"

# --- Dokploy (running version vs latest GitHub release) — skip cleanly if Dokploy isn't installed ---
cur=$(docker service inspect dokploy --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}' 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)
if [ -n "$cur" ]; then
  latest=$(curl -fsS -m 15 https://api.github.com/repos/Dokploy/dokploy/releases/latest 2>/dev/null \
           | grep -oE '"tag_name"[^,]*' | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  dok="Dokploy: ${cur}"
  if [ -n "$latest" ] && [ "$cur" != "$latest" ]; then
    dok="$dok -> ${latest} UPDATE AVAILABLE"; updates=1
  else
    dok="$dok (latest ${latest:-?})"
  fi
else
  dok="Dokploy: not installed"
fi

report="$(date -Is) | $os | $dok | container images: see Renovate PRs on <ORG>/infra"
echo "$report"

if [ -n "${UPDATE_HC_URL:-}" ]; then
  suffix=""; [ "$updates" = 1 ] && suffix="/fail"
  curl -fsS -m 15 --data-raw "$report" "${UPDATE_HC_URL}${suffix}" -o /dev/null || true
fi
