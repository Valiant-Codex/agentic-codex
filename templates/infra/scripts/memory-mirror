#!/usr/bin/env bash
# memory-mirror — make an agent's runtime memory durable in Git.
#
# Copies the agent's Claude Code auto-memory (the WORKING tier: fast, auto-captured by the runtime,
# git-ignored, and NOT portable — it does not survive a re-provision or a framework switch) into its
# brain repo at memory/auto/, then commits and pushes. That is all it does: rsync + git. No model, no
# judgement, no nondeterminism — which is why it is safe to run unattended.
#
# It is one half of the two-tier memory model (see shared/policies/memory-policy.md):
#   working tier  -> this script -> memory/auto/            (automatic, deterministic, durable)
#   memory/auto/  -> the `agent-audit` skill -> distilled-memory.md   (curated, with the owner present)
#
# NAMING (2026-07-25): this was called `dream`, which promised a nightly reflect-and-consolidate pass
# it no longer performs. The model-driven consolidation was evaluated and NOT adopted — its value
# rested on one good run while it needed three supervising mechanisms, three same-day bug fixes, and
# vendor-specific CLI flags (reasoning: docs/memory.md). The hardened
# implementation is retrievable from the reference implementation history if it is ever revived — as its own
# script, honestly named.
#
# Guarantees:
#   * SECRET SCAN before staging: session-derived content can contain credentials, and a secret in Git
#     is not undoable. A hit aborts without committing and reports it for rotation.
#   * FAIL CLOSED: any error exits non-zero, so the systemd unit lands in `failed` and agentic-monitor
#     surfaces it. Silence must never be mistaken for success.
#   * Commits are prefixed "[mirror]" — greppable and mass-revertible.
#
# Invoked per-agent by memory-mirror@<user>.timer (~05:00, staggered). Canonical source: <ORG>/infra.
set -uo pipefail

usage(){ echo "usage: memory-mirror <agent-user>" >&2; exit 2; }
U="${1:-}"; [ -n "$U" ] || usage
TODAY="$(date +%F)"
RC=0
log(){ echo "$(date -Is) memory-mirror/$U: $*"; }
fail(){ log "ERROR: $*"; RC=1; }
# NEVER `bash -lc`: a login shell sources the agent's OWN ~/.profile, so an agent-planted
# `git() { return 0; }` there makes `git diff --cached --quiet` succeed and this script log
# "mirror: no changes" every night while durability is silently OFF — the same hole
# agentic-monitor closed on 2026-07-26. Explicit PATH, no profile, no rc.
AGENT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
run(){ runuser -u "$U" -- env PATH="$AGENT_PATH" bash --noprofile --norc -c "$1"; }

# Conservative secret pattern set. False positives are cheap (a skipped night + a look);
# a committed credential is not.
SECRET_RE='BEGIN [A-Z ]*PRIVATE KEY|oauth_token|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|Bearer [A-Za-z0-9._~+/-]{25,}|(password|passwd|api[_-]?key|secret|token)[[:space:]]*[:=][[:space:]]*[^[:space:]"'"'"']{12,}'
scan(){ grep -rilE "$SECRET_RE" "$1" 2>/dev/null; }   # prints offending files, if any

# `getent | cut` exits with cut's status, always 0, so this `||` branch was dead: a roster typo
# reached the brain-repo check instead and reported the misleading "brain repo not found". Ask getent directly.
getent passwd "$U" >/dev/null || { log "ERROR: no such user '$U'"; exit 1; }
HOME_DIR="$(getent passwd "$U" | cut -d: -f6)"
BASE="$HOME_DIR/github"
# NEVER `head -1` here. This job is an UNATTENDED WRITER: it rsyncs --delete into the repo it picks
# and then commits and pushes there. With two candidates (a rename left half-done) the old
# first-match would silently mirror the agent's memory into the WRONG repo and publish it — while
# claude-topic, facing the identical ambiguity, refuses to start at all. The writer must be at
# least as cautious as the launcher, so: refuse and alarm rather than guess.
mapfile -t BRAINS < <(ls -d "$BASE"/*/kb-agent-*-"$U" 2>/dev/null)
if [ "${#BRAINS[@]}" -gt 1 ]; then
  log "ERROR: multiple candidate brain repos under $BASE (${BRAINS[*]}) — refusing to guess which is real; mirroring into the wrong one would publish this agent's memory to the wrong repo"
  exit 1
fi
BRAIN="${BRAINS[0]:-}"
[ -n "$BRAIN" ] && [ -d "$BRAIN/.git" ] || { log "ERROR: brain repo not found under $BASE"; exit 1; }
AUTOMEM="$HOME_DIR/.claude/projects/-home-$U/memory"

# ---------- Phase A: mirror (deterministic) ----------
if [ -d "$AUTOMEM" ]; then
  hits="$(scan "$AUTOMEM")"
  if [ -n "$hits" ]; then
    fail "secret-like content in runtime auto-memory — NOT mirroring. Review (and rotate if real):"
    echo "$hits" | sed 's/^/    /'
  else
    DEST="$BRAIN/memory/auto"
    run "mkdir -p '$DEST' && rsync -a --delete '$AUTOMEM/' '$DEST/'" || fail "mirror rsync failed"
    run "cd '$BRAIN' && git add memory/auto" || fail "mirror: git add failed"
    if run "cd '$BRAIN' && git diff --cached --quiet -- memory/auto"; then
      log "mirror: no changes"
    else
      # Read the unpushed count BEFORE adding a commit of our own, and PATH-SCOPE the commit.
      # Two distinct hazards, both of them this job quietly publishing work that is not its own:
      #   * `git commit` with no pathspec commits everything already staged, so an agent that had
      #     staged an unrelated half-finished edit would find it swept into a "[mirror]" commit;
      #   * `git push` publishes the whole branch, so any pre-existing unpushed commits would go
      #     out too — unreviewed, on this timer's clock rather than the agent's. That is exactly
      #     what 2026-07-27-commit-push-atomic-and-daily-drift-report rejected when it declined to
      #     teach kb-sync to push. When the repo is already ahead we commit and stop, leaving the
      #     divergence for agentic-divergence-check to report.
      ahead="$(run "cd '$BRAIN' && git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 && git rev-list --count '@{u}..HEAD' 2>/dev/null || echo unknown")"
      if run "cd '$BRAIN' && git commit -q -m '[mirror] runtime auto-memory ($TODAY)' -- memory/auto"; then
        case "$ahead" in
          0) run "cd '$BRAIN' && git push -q" && log "mirror: committed + pushed" \
               || fail "mirror: push failed (commit is local only)" ;;
          unknown) fail "mirror: committed but branch has no upstream — not pushing (commit is local only)" ;;
          *) fail "mirror: committed but NOT pushed — repo already had $ahead unpushed commit(s) and pushing would publish them unreviewed" ;;
        esac
      else
        fail "mirror: commit failed"
      fi
    fi
    # --- POST-MIRROR ASSERTIONS. Deliberately AFTER the push, never before. -------------------------
    #
    # This job asserted a great deal about its own execution and nothing about its RESULT. Two ways
    # memory is lost that nothing on this box would have noticed:
    #
    #   (a) A file with no line in MEMORY.md is invisible to recall. The bytes are safe in git and the
    #       fact is gone, which is worse than an error — it looks healthy. Found twice independently
    #       in a single day in the reference deployment: five orphans in one agent's store, and four
    #       (13.7 KB) in another's.
    #   (b) rsync --delete propagates a disappearance from the store into the repo and commits it under
    #       a generic "[mirror]" message. Recoverable from history, but only if someone reads the diff.
    #
    # These RAISE RC; they never abort. The secret scan aborts before mirroring on purpose — a secret in
    # git cannot be un-published. This is the opposite case: aborting on a coverage gap would turn a
    # findability problem into a durability outage, i.e. the check would cause a worse loss than the one
    # it prevents. That guard/ordering inversion is a bug class this fleet has already paid for. Mirror,
    # push, THEN assert.
    #
    # Vocabulary-free: it counts files and looks for "(<filename>)" in the index. Nothing to maintain.
    idx="$AUTOMEM/MEMORY.md"
    if [ -f "$idx" ]; then
      orphans=""
      for f in "$AUTOMEM"/*.md; do
        [ -e "$f" ] || continue
        b="$(basename "$f")"; [ "$b" = "MEMORY.md" ] && continue
        grep -qF "($b)" "$idx" || orphans="$orphans $b"
      done
      [ -n "$orphans" ] && fail "memory NOT reachable: $(echo $orphans | wc -w) file(s) have no line in MEMORY.md, so recall cannot find them —$orphans"
    else
      fail "no MEMORY.md in $AUTOMEM — every memory is unreachable to recall until an index exists"
    fi

    # Did the count go DOWN? A drop is legitimate (a memory can be deleted deliberately) but it must
    # never pass unremarked: this is the one place that sees the before and the after.
    now_n="$(ls -1 "$AUTOMEM"/*.md 2>/dev/null | grep -cv '/MEMORY\.md$' || true)"
    prev_n="$(run "cd '$BRAIN' && git show HEAD~1:memory/auto 2>/dev/null | grep -c '\.md$' || echo unknown")"
    case "$prev_n" in
      ''|unknown) : ;;
      *) [ "${now_n:-0}" -lt "$prev_n" ] && fail "memory count DROPPED $prev_n -> $now_n — rsync --delete has just propagated a disappearance into the repo; check 'git show HEAD -- memory/auto' before it scrolls away" ;;
    esac
    # ------------------------------------------------------------------------------------------------

  fi
elif [ -d "$BRAIN/memory/auto" ] && [ -n "$(ls -A "$BRAIN/memory/auto" 2>/dev/null)" ]; then
  # The source is gone but we have mirrored it before: this is a REGRESSION, not a fresh agent.
  # Most likely the runtime moved its memory path (an upgrade), which would otherwise silently
  # switch off the whole durability chain while memory/auto/ kept looking healthy in git.
  fail "auto-memory path $AUTOMEM has DISAPPEARED but memory/auto/ holds a previous mirror — the runtime probably moved it. Durability is OFF until the path is fixed."
else
  # No source and nothing mirrored before: a genuinely new agent with no memory yet. Quiet skip.
  log "mirror: no auto-memory at $AUTOMEM and none mirrored before (new agent — skip)"
fi

log "done"
exit $RC
