#!/usr/bin/env bash
# provision-agent — bring an agent up on THIS box from git + secrets.
#
# Tier-3 of the config model (see the Agentic Codex docs, config-model.md): the explicit,
# reviewable step that APPLIES what git carries — clones the brain + shared sibling,
# wires the symlinks, installs the root-owned topic wrapper + per-user systemd unit,
# materializes settings as a real copy (not a live symlink into the auto-synced repo),
# registers the agent in the fleet roster, and enables linger + topic sessions + the
# nightly memory mirror. Secrets are NOT in git: the agent's gh token (and any MCP
# secrets) must be restored out-of-band first — the script fails fast if it is missing.
#
# Idempotent: safe to re-run on an already-provisioned agent (converges, no churn).
# Run as the privileged root-agent user (self-elevates):
#   ORG=<your-github-org> provision-agent <unix-user> <brain-repo>
#   e.g. ORG=acme-labs provision-agent root-agent kb-agent-ops-root-agent
set -euo pipefail

# Raise through one helper so the propagation check can see these guards. Extra arguments are printed
# as further lines before exiting, so multi-line remediation text is not swallowed. Output stays on
# stdout, exactly where these messages already went.
fail() { printf 'FATAL: %s\n' "$1"; shift; for l in "$@"; do printf '%s\n' "$l"; done; exit 1; }

# --- self-elevate (runuser + /usr/local/bin + linger need root) ---
# Forward the vars explicitly: a `!setenv` sudoers policy strips `sudo -E`, which would silently
# fall back to defaults instead of failing.
[ "$(id -u)" = 0 ] || exec sudo ORG="${ORG:-}" INFRA="${INFRA:-}" "$0" "$@"

U="${1:?usage: [ORG=<github-org>] provision-agent <unix-user> <brain-repo>}"
BRAIN="${2:?usage: [ORG=<github-org>] provision-agent <unix-user> <brain-repo>}"
ORG="${ORG:?set ORG=<your-github-org> (the GitHub org that owns the brain + infra repos)}"
ORG_URL="https://github.com/${ORG}"
# infra (source of the wrapper + unit) comes from the PROVISIONER'S OWN clone — resolved via
# SUDO_USER (this script self-elevates, so SUDO_USER is the human-driven invoking user). NEVER
# glob every /home/*: any unprivileged agent can clone infra into its own home (org read is
# enough) with malicious COMMITTED changes — the dirty-worktree guard below would pass — and a
# first-match glob would then install that agent's bin/claude-topic ROOT-OWNED for the whole
# fleet: precisely the channel the three-tier config model exists to forbid. Override with
# INFRA=/path/to/infra only if you know why.
if [ -z "${INFRA:-}" ]; then
  _ihome="$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)"
  for d in "$_ihome"/github/*/infra; do [ -d "$d/.git" ] && INFRA="$d" && break; done
fi
[ -n "${INFRA:-}" ] && [ -d "$INFRA/.git" ] || { echo "FATAL: cannot find an 'infra' git clone under the invoking user's home; set INFRA=/path/to/infra"; exit 1; }

# `getent | cut` always exits 0 (the pipeline status is cut's), so `|| true` was dead and a
# nonexistent user fell through to the emptiness check below. Ask getent directly instead.
getent passwd "$U" >/dev/null || fail "no such user '$U'"
H="$(getent passwd "$U" | cut -d: -f6)"
[ -n "${H:-}" ] || fail "user '$U' has no home directory"
BASE="$H/github/$ORG"

# NEVER `bash -lc` here. A login shell sources the target user's OWN ~/.profile, so an
# agent-planted `git() { ...; }` or `gh() { ...; }` there would intercept every command this
# provisioner runs as them — the identical hole agentic-monitor closed on 2026-07-26. Every binary
# this script needs (git, gh, rsync, python3, systemctl) lives in the standard PATH, so hand it one
# explicitly and skip profile/rc entirely.
# The agent's own ~/.local/bin and ~/.local/node are deliberately NOT on this PATH, even though a
# login shell had them: they are agent-writable, so putting them here would trade a shell-function
# hijack for a planted-binary hijack. System dirs first would protect the binaries we call today, but
# not a future call to `claude` or `node` — which would resolve to the agent-writable copy, i.e.
# precisely the thing such an addition would be for. The constraint this imposes: nothing in these
# scripts may invoke a tool that lives only under the agent's home. If that is ever needed, call it
# by absolute path and check its ownership first.
AGENT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
asU() { runuser -u "$U" -- env PATH="$AGENT_PATH" bash --noprofile --norc -c "$*"; }

echo "== provision-agent: $U ($BRAIN) on $(hostname -s) =="

# 0) Precondition — secret must already be restored (not carried in git).
if ! asU 'gh auth status >/dev/null 2>&1'; then
  fail "'$U' has no working gh auth." \
       "  Restore the bot token to ~$U/.config/gh/hosts.yml (mode 600) first — it is a secret," \
       "  never in git. Then set the git identity and re-run:" \
       "    git config --global user.name  <bot-username>" \
       "    git config --global user.email  <id>+<bot-username>@users.noreply.github.com"
fi

# 0b) Wrapper preconditions — READ-ONLY git checks, done BEFORE anything is mutated.
#    These used to sit next to the install itself; when the install moved after the per-agent work
#    (see 4b), they moved with it — so a dirty/unpushed wrapper aborted the run only AFTER the
#    agent's repos, ~/CLAUDE.md and ~/.claude/settings.json had already been written, leaving a
#    half-provisioned agent in no roster with no durable memory. A check that can run first must
#    run first; only the mutation belongs late.
# `git status --porcelain`, not `git diff`: `diff --quiet -- <path>` compares worktree against the
# INDEX (so a `git add`ed but uncommitted wrapper passed) and, worse, exits 0 for a path git does
# not track at all — an UNTRACKED bin/claude-topic sailed straight through. `status --porcelain`
# reports modified, staged and untracked in one shot. Scoped to what this script installs.
DIRT="$(git -C "$INFRA" status --porcelain -- bin/claude-topic systemd/claude-topic@.service systemd/claude-topic-rotate-on-boot.service fleet-agents 2>/dev/null)"
if [ -n "$DIRT" ]; then
  echo "$DIRT" | sed 's/^/         /'
  echo "  [FAIL] $INFRA has uncommitted or untracked changes in the files this script installs"
  echo "         (listed above) — installing them would push unreviewed code to ALL agents."
  echo "         Commit or revert them first."
  exit 1
fi
# AHEAD is a FAIL, not a warn: a locally-committed wrapper passes the dirty check above, and
# installing it root-owned fleet-wide before it is pushed/reviewed is exactly the channel the
# three-tier config model forbids. Push first; origin is the reviewable source of truth.
# FAIL-CLOSED on a missing upstream: the old `|| echo unknown` + `!= unknown` form SKIPPED this
# guard entirely for a clone with no upstream (a locally created branch, a detached HEAD, a repo
# not yet pushed), so an unreviewed unpushed wrapper installed fleet-wide with the guard printing
# [ok]. Reproduced. claude-topic's reg_commit and memory-mirror already had the right shape.
if ! git -C "$INFRA" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  echo "  [FAIL] $INFRA has no upstream branch, so 'is this code pushed and reviewable?' cannot be"
  echo "         answered — refusing to install it root-owned fleet-wide. Push it and set an"
  echo "         upstream (git push -u origin <branch>) first."
  exit 1
fi
# NOT `|| echo 0` -- see install-host-services: a failed rev-list must not read as "nothing
# unpushed" in the guard that refuses to install unreviewed root-owned code.
INFRA_AHEAD="$(git -C "$INFRA" rev-list --count '@{u}..HEAD' 2>/dev/null || true)"
if [ -z "$INFRA_AHEAD" ]; then
  echo "  [FAIL] cannot count unpushed commits in $INFRA — refusing to install root-owned code"
  echo "         from a repo whose state I could not read."
  exit 1
fi
if [ "${INFRA_AHEAD:-0}" != 0 ]; then
  echo "  [FAIL] $INFRA has $INFRA_AHEAD commit(s) not on origin — refusing to install an"
  echo "         unpushed wrapper fleet-wide. Push (and let it be reviewable) first."
  exit 1
fi
INFRA_BEHIND="$(git -C "$INFRA" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
if [ "${INFRA_BEHIND:-0}" != 0 ]; then
  echo "  [WARN] $INFRA is ${INFRA_BEHIND} commit(s) behind origin — the wrapper about to be"
  echo "         installed fleet-wide may be stale. 'git -C $INFRA pull --ff-only' first if unsure."
fi

# 0c) Roster shrink guard — a READ-ONLY comparison, so it runs here with the other preconditions
#     rather than at step 8. It used to sit next to the roster install, which meant an abort could
#     happen only AFTER step 4b had already replaced the fleet-wide wrapper: the same
#     "wide-blast action before a validation that could abort it" class that moving the wrapper
#     install fixed on 2026-08-01, just a few steps later in the same script.
ROSTER_SRC="$INFRA/fleet-agents"
ROSTER_DST=/usr/local/share/agentic/fleet-agents
if [ -f "$ROSTER_SRC" ] && [ -f "$ROSTER_DST" ]; then
  lost=""
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    grep -qxF "$nm" <(grep -vE '^[[:space:]]*(#|$)' "$ROSTER_SRC" | tr -d ' \t\r') && continue
    # only names that are still real agents on this box (a decommissioned one SHOULD disappear)
    getent passwd "$nm" >/dev/null 2>&1 || continue
    ls -d "$(getent passwd "$nm" | cut -d: -f6)"/github/*/kb-agent-*-"$nm" >/dev/null 2>&1 && lost="$lost $nm"
  done < <(grep -vE '^[[:space:]]*(#|$)' "$ROSTER_DST" | tr -d ' \t\r')
  if [ -n "${lost// /}" ]; then
    echo "  [FAIL] refusing to install a roster that DROPS live agent(s):$lost"
    echo "         $ROSTER_SRC does not list them, but they have Unix users and brain repos on this box."
    echo "         Installing it would silently remove them from kb-sync and agentic-monitor."
    echo "         Fix the roster in this infra clone (or provision from the canonical one), then re-run."
    exit 1
  fi
fi

# 2) Repos — brain + kb-agent-shared sibling (clone if missing; else kb-sync keeps them fresh).
asU "mkdir -p '$BASE'"
for r in "$BRAIN" kb-agent-shared; do
  if asU "[ -d '$BASE/$r/.git' ]"; then echo "  [skip] $r already cloned"
  else asU "git -C '$BASE' clone $ORG_URL/$r.git" && echo "  [ok] cloned $r"; fi
done

# 3) Symlinks — shared, CLAUDE.md, topic (all idempotent).
asU "ln -sfn ../kb-agent-shared '$BASE/$BRAIN/shared'"
# ~/CLAUDE.md is what the running agent actually loads: the topic unit sets WorkingDirectory=%h, so
# cwd is the home dir and only THIS file is read in normal operation. ONE layout (2026-07-30):
# the brain's root CLAUDE.md is the single bootstrap, written with absolute ~/github/... paths so it
# resolves from any cwd. The old three-layer variant (deploy/home-CLAUDE.md + repo-root
# CLAUDE.md/AGENTS.md adapters) was dropped fleet-wide: it duplicated the bootstrap for a second
# runtime nobody runs, and the copies drifted. Never symlink to a path that does not exist: a
# dangling ~/CLAUDE.md means the agent boots with NO bootstrap and nothing says so.
if asU "[ -f '$BASE/$BRAIN/CLAUDE.md' ]"; then
  asU "ln -sfn '$BASE/$BRAIN/CLAUDE.md' '$H/CLAUDE.md'"; BOOTSTRAP="CLAUDE.md"
else
  echo "  [FAIL] $BRAIN has no root CLAUDE.md — refusing to create a dangling ~/CLAUDE.md."
  echo "         Seed the brain repo first (see the manage-agents skill)."
  exit 1
fi
asU "mkdir -p '$H/.local/bin' && ln -sfn /usr/local/bin/claude-topic '$H/.local/bin/claude-topic'"
# Skills: ~/.claude/skills is a WHOLE-DIRECTORY symlink to the brain's skills/, so every
# skills/<name>/SKILL.md (including fleet-common ones symlinked from shared/) is discovered
# with no per-skill registration. Without this the agent's skills are invisible to the harness.
asU "mkdir -p '$H/.claude' && [ ! -e '$H/.claude/skills' ] || [ -L '$H/.claude/skills' ] || mv '$H/.claude/skills' '$H/.claude/skills.bak.$(date +%s)'"
asU "ln -sfn '$BASE/$BRAIN/skills' '$H/.claude/skills'"
# Fleet-common skills: symlink every shared/skills/<name> into the brain's skills/, so they are
# discovered through the whole-dir symlink above. Auto-discovers whatever the shared layer ships,
# so adding a fleet-common skill needs no per-agent step. Idempotent; never clobbers a real dir.
asU 'shopt -s nullglob; cd "'"$BASE/$BRAIN"'" && mkdir -p skills && for s in shared/skills/*/; do n=$(basename "$s"); [ -e "skills/$n" ] || ln -s "../shared/skills/$n" "skills/$n"; done'
# Those symlinks are part of the brain's declared shape, so they belong in git — but provisioning
# must never commit into an agent's own repo, so say it instead of silently leaving the worktree
# dirty forever (a freshly provisioned brain had 5 untracked symlinks from minute one; end-to-end
# test, 2026-08-01).
UNTRACKED_SKILLS="$(asU "cd '$BASE/$BRAIN' && git ls-files --others --exclude-standard -- skills/ 2>/dev/null | tr '\n' ' '" || true)"
[ -n "${UNTRACKED_SKILLS// /}" ] && echo "  [note] untracked file(s) under skills/ in $BRAIN (the fleet-common symlinks just created, and anything else) — commit what belongs in git so the brain repo stays clean: $UNTRACKED_SKILLS"
echo "  [ok] symlinks: shared, ~/CLAUDE.md -> $BOOTSTRAP, ~/.local/bin/claude-topic, ~/.claude/skills"

# 3b) Output style (voice/register) — symlink if the brain declares one. This is a live symlink,
#    same as CLAUDE.md and skills, not a copy: it carries no permission grant, so the settings.json
#    reasoning (F1/F3, real copy so it does not live-follow the repo) does not apply to it.
#    Optional: not every agent has one, and provisioning must not fail an agent that doesn't.
SRC_STYLE="$BASE/$BRAIN/deploy/output-styles/$U.md"
if asU "[ -f '$SRC_STYLE' ]"; then
  asU "mkdir -p '$H/.claude/output-styles' && ln -sfn '$SRC_STYLE' '$H/.claude/output-styles/$U.md'"
  echo "  [ok] ~/.claude/output-styles/$U.md -> deploy/output-styles/$U.md"
else
  echo "  [skip] $BRAIN has no deploy/output-styles/$U.md — no output style to symlink"
fi

# 4) Settings — install the curated, portable source as a REAL copy (not a symlink).
#    Auto-accumulated ~/.claude/settings.local.json is left untouched (per-machine, git-ignored).
SRC_SETTINGS="$BASE/$BRAIN/deploy/claude-settings.json"
if asU "[ -f '$SRC_SETTINGS' ]"; then
  # Install to a temp path and mv, never `rm -f && install`: under `set -e` an install failure in
  # the second form exits with the agent's settings.json DELETED — i.e. a failed provisioning
  # leaves the agent worse off than not running this at all. `mv` within the same directory is
  # atomic, so the file is either the old one or the new one, never absent.
  asU "mkdir -p '$H/.claude' && install -m0600 '$SRC_SETTINGS' '$H/.claude/.settings.json.new' && mv '$H/.claude/.settings.json.new' '$H/.claude/settings.json'"
  echo "  [ok] ~/.claude/settings.json (real copy from deploy/claude-settings.json)"
else
  echo "  [warn] $BRAIN has no deploy/claude-settings.json — skipping settings install"
fi

# 4b) Root-owned claude-topic wrapper (global; source in infra).
#    ORDERING IS DELIBERATE (moved after the per-agent work): this is the ONE step with a FLEET-WIDE
#    side effect, and it used to run first — so a provisioning that failed later (a clone that could
#    not be written, a missing bootstrap) still left every other agent's wrapper replaced, with
#    nothing to roll it back. Found by an end-to-end throwaway provisioning test, where exactly that
#    happened. Doing it here means the blast-radius step only runs once this agent's own
#    repos/symlinks/settings are actually in place.
#    This is a per-agent command with a FLEET-WIDE side effect: it rewrites the wrapper every agent
#    executes, from whatever state the provisioner's infra clone happens to be in. Provisioning one
#    new agent from a stale or locally-edited clone would silently change what all the others run.
#    So say what is being installed, and refuse to do it silently from a clone that disagrees with
#    origin.
if cmp -s "$INFRA/bin/claude-topic" /usr/local/bin/claude-topic; then
  echo "  [skip] /usr/local/bin/claude-topic already matches $INFRA/bin/claude-topic"
else
  install -m0755 -o root -g root "$INFRA/bin/claude-topic" /usr/local/bin/claude-topic
  echo "  [ok] /usr/local/bin/claude-topic (root-owned) — CHANGED, affects every agent"
fi

# 5) systemd user unit — real copy from infra (not a symlink into shared).
asU "mkdir -p '$H/.config/systemd/user'"
install -m0644 -o "$U" -g "$U" "$INFRA/systemd/claude-topic@.service" "$H/.config/systemd/user/claude-topic@.service"
echo "  [ok] ~/.config/systemd/user/claude-topic@.service"
install -m0644 -o "$U" -g "$U" "$INFRA/systemd/claude-topic-rotate-on-boot.service" "$H/.config/systemd/user/claude-topic-rotate-on-boot.service"
echo "  [ok] ~/.config/systemd/user/claude-topic-rotate-on-boot.service"

# 6) Linger (survive reboot without login) + WAIT for the user bus.
#    `loginctl enable-linger` returns as soon as the linger flag is set — it does NOT wait for
#    systemd to have the per-user manager and its D-Bus socket up. On a FIRST provisioning of a
#    brand-new user, /run/user/<uid>/bus therefore does not exist yet and step 7 raced it: every
#    `systemctl --user` call died with "Failed to connect to bus", the topics were left disabled,
#    and the old step 7 still printed "[ok]". Hit on 2026-07-29 provisioning the reference deployment's fourth agent. Only bites on
#    the first run for a user — i.e. exactly when it matters. So: start the manager explicitly,
#    then poll for the socket instead of assuming it.
UID_N="$(id -u "$U")"
loginctl enable-linger "$U" >/dev/null 2>&1 || true
systemctl start "user@${UID_N}.service" >/dev/null 2>&1 || true
BUS="/run/user/${UID_N}/bus"
for _ in $(seq 1 60); do [ -S "$BUS" ] && break; sleep 0.5; done
if [ -S "$BUS" ]; then
  echo "  [ok] linger enabled (user bus ready at $BUS)"
else
  echo "  [FAIL] user bus $BUS never appeared after 30s — cannot enable topics."
  echo "         Inspect: loginctl show-user $U ; systemctl status user@${UID_N}.service"
  exit 1
fi

# 7) Topic sessions — enable (+start) each key from the versioned registry.
#    Reports the REAL state and fails loudly: a topic that did not come up is a broken
#    provisioning, not a warning to scroll past.
TOPIC_FAIL=0
asU '
  set -u
  export XDG_RUNTIME_DIR=/run/user/$(id -u); export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
  systemctl --user daemon-reload || { echo "  [FAIL] systemctl --user daemon-reload"; exit 1; }
  # Rotate-on-boot: `enable`, deliberately NOT `--now`. Running it here would rotate the
  # conversations of an agent being RE-provisioned — this unit is only ever meant to fire at
  # boot, where nothing is mid-task. Not fatal if it fails: topics still come back, they just
  # need their bridges tested by hand, which is where the fleet was before this existed.
  if systemctl --user enable claude-topic-rotate-on-boot.service >/dev/null 2>&1; then
    echo "  [ok] claude-topic-rotate-on-boot.service enabled (fires at boot, not now)"
  else
    echo "  [warn] could not enable claude-topic-rotate-on-boot.service — after any reboot this"
    echo "         agent needs '\''claude-topic urls'\'' and a manual rotate of whatever is unreachable"
  fi
  REG="'"$BASE/$BRAIN"'/deploy/topics.tsv"
  if [ ! -f "$REG" ]; then echo "  [warn] no deploy/topics.tsv — no topics enabled"; exit 0; fi
  rc=0
  # Read with awk on a literal TAB, matching claude-topic. `while read -r key name` split on ANY
  # whitespace and silently dropped a final line with no trailing newline — so a hand-edited
  # registry could lose its last topic here and in agentic-monitor while claude-topic still saw it.
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    if systemctl --user enable --now "claude-topic@${key}.service" >/dev/null 2>&1; then
      st="$(systemctl --user is-active "claude-topic@${key}.service" 2>/dev/null || true)"
    else
      st="enable-failed"
    fi
    case "$st" in
      active|activating) echo "  [ok] topic ${key} ($st)";;
      *)                 echo "  [FAIL] topic ${key} (${st:-unknown})"; rc=1;;
    esac
    # CAPTURE THE SESSION ID. Enabling the unit starts the session but stores nothing, so the topic
    # ran with an EMPTY sessionId and ~/.config/agent/topics.state did not even exist — meaning the
    # next reboot (or any restart) would start a BLANK conversation and orphan the history, which is
    # the exact incident `claude-topic` was built to prevent, reached through the provisioning door.
    # The runbook even says "active with an empty sessionId is not healthy" while this step produced
    # precisely that. Reproduced end-to-end on 2026-08-01. `remember` is the verb the wrapper provides for
    # this; the session file appears a beat after exec, so retry briefly. Never fatal: a topic that
    # is up but not yet remembered is recoverable with one command, and we print it.
    if [ "$st" = active ] || [ "$st" = activating ]; then
      remembered=0
      for _try in $(seq 1 20); do   # > the 15s budget claude-topic itself allows for the session file
        if claude-topic remember "$key" >/dev/null 2>&1; then remembered=1; break; fi
        sleep 1
      done
      [ "$remembered" = 1 ] || echo "  [warn] topic ${key} started but no sessionId stored yet — run: claude-topic remember ${key}"
    fi
  done < <(awk -F"\t" "\$1 !~ /^[[:space:]]*(#|\$)/ {print \$1}" "$REG")
  exit $rc
' || TOPIC_FAIL=1

# 8) Roster membership — the roster is what kb-sync / agentic-monitor / divergence-check iterate, so
#    an agent that is provisioned but unlisted is silently unsynced and unmonitored while the monitor
#    keeps reporting green. Registering it here is what makes provisioning a complete pipeline
#    instead of a step someone has to remember to follow.
#    The shrink guard that protects this ran at step 0c, before anything was mutated.
if [ -f "$ROSTER_SRC" ]; then
  ROSTER_APPEND=0
  grep -qxF "$U" "$ROSTER_SRC" || ROSTER_APPEND=1
  # Mutate the clone and the live copy only here. Appending first meant an aborted run left the
  # clone edited and "COMMIT AND PUSH" printed for work it then undid.
  if [ "$ROSTER_APPEND" = 1 ]; then
    printf '%s\n' "$U" >> "$ROSTER_SRC"
    echo "  [ok] added '$U' to $ROSTER_SRC — COMMIT AND PUSH the infra repo so it is not local-only"
  else
    echo "  [skip] '$U' already in $ROSTER_SRC"
  fi
  install -D -m0644 "$ROSTER_SRC" "$ROSTER_DST"
  echo "  [ok] $ROSTER_DST refreshed"
else
  echo "  [WARN] no $ROSTER_SRC — cannot register '$U'; kb-sync/monitor/divergence-check may not cover it"
fi

# 9) Nightly memory mirror for this agent. Enabled by DEFAULT: it is the only thing that makes the
#    agent's runtime auto-memory durable, and leaving it opt-in is how the reference deployment's fourth agent ran for a day with
#    durability silently off and no check able to see it. It is a deterministic rsync+git with a
#    secret scan and no model in the loop — the reason it was safe to run unattended in the first
#    place. Disable deliberately with: systemctl disable --now memory-mirror@$U.timer
#    This is an UNATTENDED WRITER (it commits and pushes to the brain repo nightly), so say plainly
#    what it will write and how to switch it off — that disclosure is what CLAUDE.md's gate asks
#    for, and provisioning is the explicit, human-invoked moment where it belongs.
MIRROR_FAIL=0
if [ -f /etc/systemd/system/memory-mirror@.timer ]; then
  echo "  -- enabling the nightly memory mirror for '$U' --"
  echo "     writes: ~$U/.claude/projects/-home-$U/memory  ->  <brain>/memory/auto/, then commits"
  echo "             '[mirror] …' and pushes. Secret-scans before staging; aborts on a hit."
  echo "     off:    sudo systemctl disable --now memory-mirror@${U}.timer"
  if err_out="$(systemctl enable --now "memory-mirror@${U}.timer" 2>&1)"; then
    echo "  [ok] memory-mirror@${U}.timer enabled (nightly ~05:00, staggered)"
  else
    echo "  [FAIL] could not enable memory-mirror@${U}.timer — this agent's memory is NOT durable"
    echo "$err_out" | sed 's/^/         /'
    MIRROR_FAIL=1
  fi
else
  echo "  [FAIL] memory-mirror@.timer not installed — run install-host-services first;"
  echo "         until then '$U' has no durable memory."
  MIRROR_FAIL=1
fi

echo "== done. Reminder — restore out-of-band (not in git): MCP secrets in ~$U/.claude.json,"
echo "   any ~$U/.config/$U/secrets.env, and Node in ~$U/.local/node if the agent uses npx-based MCP. =="

if [ "$TOPIC_FAIL" != 0 ]; then
  echo
  echo "!! At least one topic did NOT come up. The agent is provisioned but not reachable."
  echo "   Inspect as the agent:  systemctl --user status 'claude-topic@*'  and  journalctl _UID=$UID_N -n 50"
  echo "   A topic whose stored sessionId has no transcript on disk needs: claude-topic restart --new <key>"
  exit 1
fi

# A printed [FAIL] with exit 0 is the same defect this batch was written to remove: the whole premise
# is that an agent ran for a day with durability silently off. So make it non-zero.
if [ "$MIRROR_FAIL" != 0 ]; then
  echo
  echo "!! '$U' is provisioned and reachable, but its memory is NOT durable — nothing will carry its"
  echo "   runtime auto-memory into git. Fix the timer before treating this provisioning as done."
  exit 1
fi
