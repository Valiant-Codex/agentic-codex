#!/usr/bin/env bash
# provision-agent — bring an agent up on THIS box from git + secrets.
#
# Tier-3 of the config model (see the Agentic Codex docs (config-model.md)): the explicit, reviewable step that
# APPLIES what git carries — clones the brain + shared sibling, wires the symlinks, installs
# the root-owned topic wrapper + per-user systemd unit, materializes settings as a real copy
# (not a live symlink into the auto-synced repo), and enables linger + topic sessions. Secrets
# are NOT in git: the agent's gh token (and any MCP secrets) must be restored out-of-band first —
# the script fails fast if the gh token is missing.
#
# Idempotent: safe to re-run on an already-provisioned agent (converges, no churn).
# Run as the privileged root-agent user (self-elevates):
#   ORG=<your-github-org> provision-agent <unix-user> <brain-repo>
#   e.g. ORG=acme-labs provision-agent root-agent kb-agent-ops-root-agent
set -euo pipefail

# --- self-elevate (runuser + /usr/local/bin + linger need root) ---
# Forward ORG/INFRA explicitly (don't rely on `sudo -E`, which a `!setenv` sudoers strips).
[ "$(id -u)" = 0 ] || exec sudo ORG="${ORG:-}" INFRA="${INFRA:-}" "$0" "$@"

U="${1:?usage: [ORG=<github-org>] provision-agent <unix-user> <brain-repo>}"
BRAIN="${2:?usage: [ORG=<github-org>] provision-agent <unix-user> <brain-repo>}"
ORG="${ORG:?set ORG=<your-github-org> (the GitHub org that owns the brain + infra repos)}"
ORG_URL="https://github.com/${ORG}"
# infra (source of the wrapper + unit) lives in the provisioner's own clone; discover it
# (first git checkout named 'infra' under any agent home). Override with INFRA=/path/to/infra.
if [ -z "${INFRA:-}" ]; then
  for d in /home/*/github/*/infra; do [ -d "$d/.git" ] && INFRA="$d" && break; done
fi
[ -n "${INFRA:-}" ] && [ -d "$INFRA/.git" ] || { echo "FATAL: cannot find an 'infra' git clone; set INFRA=/path/to/infra"; exit 1; }

H="$(getent passwd "$U" | cut -d: -f6)" || true
[ -n "${H:-}" ] || { echo "FATAL: no such user '$U'"; exit 1; }
BASE="$H/github/$ORG"
asU() { runuser -u "$U" -- bash -lc "$*"; }

echo "== provision-agent: $U ($BRAIN) on $(hostname -s), org=$ORG =="

# 0) Precondition — secret must already be restored (not carried in git).
if ! asU 'gh auth status >/dev/null 2>&1'; then
  echo "FATAL: '$U' has no working gh auth."
  echo "  Restore the bot token to ~$U/.config/gh/hosts.yml (mode 600) first — it is a secret,"
  echo "  never in git. Then set the git identity and re-run:"
  echo "    git config --global user.name  <bot-username>"
  echo "    git config --global user.email  <id>+<bot-username>@users.noreply.github.com"
  exit 1
fi

# 1) Root-owned claude-topic wrapper (once, global; source in infra).
install -m0755 -o root -g root "$INFRA/bin/claude-topic" /usr/local/bin/claude-topic
echo "  [ok] /usr/local/bin/claude-topic (root-owned)"

# 2) Repos — brain + kb-agent-shared sibling (clone if missing; else kb-sync keeps them fresh).
asU "mkdir -p '$BASE'"
for r in "$BRAIN" kb-agent-shared; do
  if asU "[ -d '$BASE/$r/.git' ]"; then echo "  [skip] $r already cloned"
  else asU "git -C '$BASE' clone $ORG_URL/$r.git" && echo "  [ok] cloned $r"; fi
done

# 3) Symlinks — shared, CLAUDE.md, topic (all idempotent).
asU "ln -sfn ../kb-agent-shared '$BASE/$BRAIN/shared'"
# ~/CLAUDE.md is what the running agent actually loads: the topic unit sets WorkingDirectory=%h, so cwd
# is the home dir and this is the only bootstrap read in normal operation. Both brain layouts work
# (see docs/portability.md, "The three bootstrap files, and which one actually runs"):
#   three-layer  — deploy/home-CLAUDE.md is the runtime bootstrap, and the repo-root CLAUDE.md/AGENTS.md
#                  are per-runtime adapters. What kb-agent-template ships; worth it if you genuinely run
#                  a second, non-Claude runtime.
#   single-file  — the brain's root CLAUDE.md IS the bootstrap, with absolute paths that resolve from any
#                  cwd. One file, nothing to drift. Pick this if you only ever use one runtime.
# deploy/home-CLAUDE.md wins when present, so the shipped template keeps working untouched.
# Either way, NEVER symlink to a path that does not exist: a dangling ~/CLAUDE.md means the agent boots
# with no bootstrap at all and nothing anywhere reports it.
if asU "[ -f '$BASE/$BRAIN/deploy/home-CLAUDE.md' ]"; then
  asU "ln -sfn '$BASE/$BRAIN/deploy/home-CLAUDE.md' '$H/CLAUDE.md'"; BOOTSTRAP="deploy/home-CLAUDE.md"
elif asU "[ -f '$BASE/$BRAIN/CLAUDE.md' ]"; then
  asU "ln -sfn '$BASE/$BRAIN/CLAUDE.md' '$H/CLAUDE.md'"; BOOTSTRAP="CLAUDE.md"
else
  echo "  [FAIL] $BRAIN has neither deploy/home-CLAUDE.md nor CLAUDE.md — refusing to create a"
  echo "         dangling ~/CLAUDE.md. Seed the brain repo first (see runbooks/manage-agents.md step a2)."
  exit 1
fi
asU "mkdir -p '$H/.local/bin' && ln -sfn /usr/local/bin/claude-topic '$H/.local/bin/claude-topic'"
# Skills: ~/.claude/skills is a WHOLE-DIRECTORY symlink to the brain's skills/, so every
# skills/<name>/SKILL.md (including fleet-common ones symlinked from shared/) is discovered
# with no per-skill registration. Without this an agent's skills are invisible to the runtime.
asU "mkdir -p '$H/.claude' && [ ! -e '$H/.claude/skills' ] || [ -L '$H/.claude/skills' ] || mv '$H/.claude/skills' '$H/.claude/skills.bak.$(date +%s)'"
asU "ln -sfn '$BASE/$BRAIN/skills' '$H/.claude/skills'"
# Fleet-common skills: symlink every shared/skills/<name> into the brain's skills/, so they are
# discovered through the whole-dir symlink above. Auto-discovers whatever the shared layer ships,
# so adding a fleet-common skill needs no per-agent step. Idempotent; never clobbers a real dir.
asU 'shopt -s nullglob; cd "'"$BASE/$BRAIN"'" && mkdir -p skills && for s in shared/skills/*/; do n=$(basename "$s"); [ -e "skills/$n" ] || ln -s "../shared/skills/$n" "skills/$n"; done'
echo "  [ok] symlinks: shared, ~/CLAUDE.md -> $BOOTSTRAP, ~/.local/bin/claude-topic"

# 4) Settings — install the curated, portable source as a REAL copy (not a symlink).
#    Auto-accumulated ~/.claude/settings.local.json is left untouched (per-machine, git-ignored).
SRC_SETTINGS="$BASE/$BRAIN/deploy/claude-settings.json"
if asU "[ -f '$SRC_SETTINGS' ]"; then
  asU "mkdir -p '$H/.claude' && rm -f '$H/.claude/settings.json' && install -m0600 '$SRC_SETTINGS' '$H/.claude/settings.json'"
  echo "  [ok] ~/.claude/settings.json (real copy from deploy/claude-settings.json)"
else
  echo "  [warn] $BRAIN has no deploy/claude-settings.json — skipping settings install"
fi

# 5) systemd user unit — real copy from infra (not a symlink into shared).
asU "mkdir -p '$H/.config/systemd/user'"
install -m0644 -o "$U" -g "$U" "$INFRA/systemd/claude-topic@.service" "$H/.config/systemd/user/claude-topic@.service"
echo "  [ok] ~/.config/systemd/user/claude-topic@.service"

# 6) Linger (survive reboot without login) + WAIT for the user bus.
#    `loginctl enable-linger` returns as soon as the linger flag is set — it does NOT wait for systemd
#    to bring up the per-user manager and its D-Bus socket. On the FIRST provisioning of a brand-new
#    user, /run/user/<uid>/bus therefore does not exist yet, and step 7 raced it: every
#    `systemctl --user` call died with "Failed to connect to bus", no topic was enabled, and the old
#    step 7 still printed "[ok]". It only bites on a user's first run — i.e. exactly when you are
#    provisioning — and the second run always looks fine, which is how it stays hidden.
#    So: start the manager explicitly, then poll for the socket instead of assuming it.
UID_N="$(id -u "$U")"
loginctl enable-linger "$U" >/dev/null 2>&1 || true
systemctl start "user@${UID_N}.service" >/dev/null 2>&1 || true
BUS="/run/user/${UID_N}/bus"
for _ in $(seq 1 60); do [ -S "$BUS" ] && break; sleep 0.5; done
if [ -S "$BUS" ]; then
  echo "  [ok] linger enabled (user bus ready at $BUS)"
else
  echo "  [FAIL] user bus $BUS never appeared after 30s — cannot enable topics."
  echo "         Inspect: loginctl show-user $U ; systemctl status user@${UID_N}.service"
  exit 1
fi

# 7) Topic sessions — enable (+start) each key from the versioned registry.
#    Reports the REAL state and fails loudly: a topic that did not come up is a broken provisioning,
#    not a warning to scroll past.
TOPIC_FAIL=0
asU '
  set -u
  export XDG_RUNTIME_DIR=/run/user/$(id -u); export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
  systemctl --user daemon-reload || { echo "  [FAIL] systemctl --user daemon-reload"; exit 1; }
  REG="'"$BASE/$BRAIN"'/deploy/topics.tsv"
  if [ ! -f "$REG" ]; then echo "  [warn] no deploy/topics.tsv — no topics enabled"; exit 0; fi
  rc=0
  while read -r key name; do
    case "$key" in ""|\#*) continue;; esac
    if systemctl --user enable --now "claude-topic@${key}.service" >/dev/null 2>&1; then
      st="$(systemctl --user is-active "claude-topic@${key}.service" 2>/dev/null || true)"
    else
      st="enable-failed"
    fi
    case "$st" in
      active|activating) echo "  [ok] topic ${key} ($st)";;
      *)                 echo "  [FAIL] topic ${key} (${st:-unknown})"; rc=1;;
    esac
  done < "$REG"
  exit $rc
' || TOPIC_FAIL=1

echo "== done. Reminder — restore out-of-band (not in git): MCP secrets in ~$U/.claude.json,"
echo "   any ~$U/.config/$U/secrets.env, and Node in ~$U/.local/node if the agent uses npx-based MCP. =="

if [ "$TOPIC_FAIL" != 0 ]; then
  echo
  echo "!! At least one topic did NOT come up. The agent is provisioned but not reachable."
  echo "   Inspect as the agent:  systemctl --user status 'claude-topic@*'  and  journalctl _UID=$UID_N -n 50"
  echo "   If the agent's first interactive login happened AFTER the topic first started, its stored"
  echo "   sessionId has no transcript on disk and 'claude-topic restart' will refuse: use"
  echo "   'claude-topic restart --new <key>' to start a fresh conversation."
  exit 1
fi
