#!/usr/bin/env bash
# agentic-divergence-check — detect structural drift across the agent fleet (security review F12),
# PLUS the weekly-turned-daily update-availability report (formerly the separate
# agentic-update-check timer, folded in 2026-07-27: one file that checks and alarms only when it
# finds something, instead of a silent daily detector feeding a once-a-week digest).
#
# READ-ONLY: it reports, it never fixes. Fixes go through `agent-audit` or a human.
# Exits 0 when clean, 1 when there is something to look at (drift OR a pending update), so the
# systemd unit lands in `failed` but SuccessExitStatus=1 (see the .service file) keeps
# agentic-monitor from paging on it — this script's own healthchecks.io ping is the alarm path for
# both concerns, not the systemd-failed-unit path (that stays reserved for the checker itself
# breaking: any exit code other than 0/1).
#
# DESIGN — two classes of check, and be honest about which is which.
#
# 1. STRUCTURAL INVARIANTS (self-maintaining, no vocabulary): the brain has the declared shape,
#    every symlink resolves, every referenced path exists, skill metadata matches its folder, each
#    clone agrees with its origin, the roster and the brains on disk agree. These stay true
#    regardless of which technologies the fleet uses and never need pruning. An earlier version
#    also grepped for stale *command patterns* (`git submodule`, `tmux …`) — a maintenance trap:
#    it encoded the 2026 stack, nobody would prune it, it would eventually pass because it matched
#    nothing (false confidence), and it could flag an agent's true memory of a past migration.
#    Judging "this doc describes the old way" is semantic work for `agent-audit` (human, periodic).
#
# 2. CURRENT-STACK ASSERTIONS (vocabulary, deliberately): topics.tsv vs the systemd units actually
#    enabled, per-agent installed artifacts (claude-settings, the topic unit), linger, the
#    memory-mirror/host timers, and the updates section at the bottom (apt, Dokploy). These encode
#    the systemd/Claude-Code runtime of today because there is no vocabulary-free way to assert
#    them — whoever changes the stack must change these checks with it, and whoever prunes this
#    file should know that class 1 will outlive class 2 by design.
#
# Managed by agentic-divergence-check.timer (daily, after the nightly memory mirror).
# Canonical source: <ORG>/infra.
set -uo pipefail

# `${VAR-default}`, not `${VAR:-default}`: an operator who empties one of these means EMPTY. The
# `:-` form silently restores the built-in, which is how a deliberately cleared list becomes last
# month's again. Unset still falls back.
ROSTER_FILE="${ROSTER_FILE-/usr/local/share/agentic/fleet-agents}"
# Brains live at ~<user>/github/<org>/kb-agent-<role>-<user>. Every org dir under ~/github is
# swept, so no ORG parameter is needed here — a literal placeholder in a path would have made the
# whole checker silently find nothing and report CLEAN.
CONF="${CONF-/etc/agentic-monitor.env}"
# shellcheck disable=SC1090
if [ -r "$CONF" ]; then
  . "$CONF"
else
  echo "FATAL: $CONF is missing or unreadable — every drift finding below would be printed and never
  delivered, and the unit sets SuccessExitStatus=1 so nothing would look failed. agentic-monitor
  guards its own HC_URL exactly this way; this script did not, until 2026-08-23." >&2
  exit 2
fi
# NOT `${VAR:?}`: that exits 1, and this script's unit sets SuccessExitStatus=1 (exit 1 means
# "drift reported", which is a successful run). So the `:?` idiom -- correct in agentic-monitor,
# which has no such setting -- would have made the likeliest failure, someone editing the env file,
# look like a clean run to systemd and to the failed-unit sweep. Copied idiom, different contract.
if [ -z "${UPDATE_HC_URL:-}" ]; then
  echo "FATAL: UPDATE_HC_URL not set in $CONF — the drift report has nowhere to go." >&2; exit 2
fi
case "$UPDATE_HC_URL" in *REPLACE-*) echo "FATAL: UPDATE_HC_URL in $CONF is still the placeholder — the drift report is being sent nowhere." >&2; exit 2;; esac
FAILS=0
DRIFT_LOG=""
drift(){ echo "  [DRIFT] $*"; FAILS=$((FAILS+1)); DRIFT_LOG="${DRIFT_LOG}${DRIFT_LOG:+; }$*"; }
case "$UPDATE_HC_URL" in *REPLACE-*) echo "FATAL: UPDATE_HC_URL in $CONF is still the placeholder — the drift report is being sent nowhere." >&2; exit 2;; esac
FAILS=0
DRIFT_LOG=""
drift(){ echo "  [DRIFT] $*"; FAILS=$((FAILS+1)); DRIFT_LOG="${DRIFT_LOG}${DRIFT_LOG:+; }$*"; }

# Every command this checker runs AS an agent goes through here. NEVER `bash -lc`: a login shell
# sources the agent's own ~/.profile, and a planted `git() { return 0; }` there makes every
# rev-list/remote-update below succeed vacuously — i.e. the fleet's drift detector reports CLEAN
# because the thing it is auditing told it to. Verified reproducible. agentic-monitor closed this on
# 2026-07-26; this script, memory-mirror and provision-agent kept the hole until 2026-07-30.
AGENT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
as_agent(){ runuser -u "$1" -- env PATH="$AGENT_PATH" bash --noprofile --norc -c "$2"; }

# Source of the per-agent artifacts provision-agent installs as real copies (checked per brain
# below). Derived from the ROOT-WRITTEN manifest (the installer records where it installed from) —
# never from globbing agent homes: an agent-planted infra clone would otherwise become the
# comparison source and could mask or fabricate installed-artifact drift. Override: INFRA_DIR=.
if [ -z "${INFRA_DIR:-}" ]; then
  INFRA_DIR="$(awk -F'|' '$1=="/etc/systemd/system/kb-sync.service"{print $2}' /usr/local/share/agentic/installed.manifest 2>/dev/null | sed 's#/systemd/kb-sync.service$##')"
fi
INFRA_DIR="${INFRA_DIR:-/nonexistent}"
# Repos that hold root-installed code and fleet governance. Unlike a brain or an app repo, nobody
# authors in these interactively for long, and a dirty worktree here is not work-in-progress — it is
# either an un-committed change to code that runs as root, or the state that makes kb-sync skip the
# repo. provision-agent appends to infra/fleet-agents and asks a human to commit it, so this is the
# assertion that keeps that from becoming the next silent manual step.
STRICT_CLEAN_REPOS="${STRICT_CLEAN_REPOS-infra kb-agent-shared}"

# Always-on context budget, in bytes: CLAUDE.md + its @-imports + the runtime auto-memory index.
# Count the index: the runtime injects it on every session and it lives OUTSIDE the repo, so a budget
# watching only CLAUDE.md can be — and in the reference deployment was — watching the cheaper half.
#
# Set it WITH HEADROOM. This assertion is for abnormal growth, not a permanent squeeze: the authored
# layer is a small share of a session next to the harness base, so trimming here optimises the wrong
# thing — and a budget treated as a target is how a curated memory file gets over-trimmed.
CONTEXT_BUDGET="${CONTEXT_BUDGET-30000}"

# Agents that are DORMANT: still on the box, still in the roster, deliberately not running. A dormant
# agent keeps its Unix user, clones and roster entry — removing it would leave an unswept home and
# would make kb-sync and the monitor stop covering it — but its unattended writers are switched OFF.
# Declarative on purpose: dormancy is a decision, and no code can infer it from the filesystem. The
# alternative (reading a DORMANT banner out of the agent's own CLAUDE.md) would let repo content
# decide what the fleet checks — content is untrusted; this list is not.
# Listing an agent here inverts the memory-mirror assertion: its timer must be OFF, so silently
# re-enabling it is caught too.
# Dormancy has ONE source on disk, shared with install-host-services: the two root-installed scripts
# used to hold separate opinions, so `--enable-writers` re-enabled the very writers this check
# asserts are off. The file is authoritative when it exists, empty included; only a missing file
# falls back, and it says so rather than pretending.
DORMANT_FILE="${DORMANT_FILE-/usr/local/share/agentic/fleet-dormant}"
if [ -n "${DORMANT_AGENTS+x}" ]; then
  :
elif [ -n "$DORMANT_FILE" ] && [ -f "$DORMANT_FILE" ]; then
  DORMANT_AGENTS="$(grep -vE '^\s*(#|$)' "$DORMANT_FILE" 2>/dev/null | tr -d ' \t\r' | tr '\n' ' ' || true)"
else
  DORMANT_AGENTS=""
  drift "roster: $DORMANT_FILE is MISSING — dormancy is unknown, so every agent is treated as active; run install-host-services"
fi

echo "$(date -Is) agentic-divergence-check"

if [ -f "$ROSTER_FILE" ]; then
  AGENTS="$(grep -vE '^\s*(#|$)' "$ROSTER_FILE" | tr -d ' \t\r')"
else
  # Not a warning. The roster is what kb-sync and agentic-monitor iterate; if it is gone they are
  # each guessing (or now failing), and that is a fleet-wide coverage failure, not a note.
  drift "roster: $ROSTER_FILE is MISSING — kb-sync/agentic-monitor cannot know the fleet; run install-host-services"
  AGENTS=""
fi

# --- roster vs reality: a brain on disk that nobody sweeps is worse than a missing one ---
DISCOVERED="$(for h in /home/*; do u="$(basename "$h")"; [ -d "$h/github" ] || continue;
  ls -d "$h"/github/*/kb-agent-*-"$u" >/dev/null 2>&1 && echo "$u"; done | sort -u)"
# Fall back to discovery ONLY when the roster FILE is missing (that case already recorded drift
# above). An EXISTING-but-empty roster must NOT be papered over: with the old unconditional
# fallback, AGENTS became DISCOVERED and the two reconciliation loops below compared the discovered
# set against itself — a no-op in exactly the shipped-template state (empty roster). Now an empty
# roster with brains on disk drifts per brain via the first loop.
[ -z "$AGENTS" ] && [ ! -f "$ROSTER_FILE" ] && AGENTS="$DISCOVERED"
for u in $DISCOVERED; do
  grep -qx "$u" <<< "$AGENTS" || drift "roster: '$u' has a brain repo on disk but is not in $ROSTER_FILE (uncovered by fleet scripts)"
done
for u in $AGENTS; do
  grep -qx "$u" <<< "$DISCOVERED" || drift "roster: '$u' is listed but has no brain repo on disk"
done

# The set every later per-agent assertion iterates. Computed ONCE, here, because the sections below
# used to each pick their own: the per-brain loop took the union while the mirror-timer, stale-timer
# and supporting-repo sections took roster-only. With an emptied or truncated roster that split made
# three assertion families go silently dark (infra/kb-agent-shared stopped being checked at all,
# including the STRICT_CLEAN_REPOS dirty guard that backstops the installers) while the stale-timer
# loop simultaneously false-positived every live agent's mirror timer as "stale teardown?" — a
# message whose remedy is to DISABLE durable memory for the whole fleet. Reproduced with an emptied
# roster: 8 findings, 4 of them wrong, and no sign that anything had stopped being asserted.
# One set, used everywhere: a roster problem then drifts once, loudly, without disarming the checker.
ALL_AGENTS="$(printf '%s\n%s\n' "$AGENTS" "$DISCOVERED" | grep . | sort -u)"

# Frontmatter must be parseable YAML — the governance says so and nothing checked it, which is how a
# decision record sat for four days with an unquoted `description:` containing ": " (invalid YAML, and
# invisible because every consumer so far has been a human eye).
#
# Two directories are exempt BY DESIGN, not by oversight (see skills/knowledge-governance-workflow):
#   CLAUDE.md      — a runtime artefact injected verbatim; frontmatter there is noise, not metadata.
#   memory/auto/** — machine-owned, byte-identical mirrors of the runtime's own store. The runtime
#                    itself emits unquoted descriptions containing colons; validating them would be a
#                    permanent false alarm about a file we must not edit.
# Fails CLOSED — and it did not, until 2026-08-22. The old shape ran the validation TWICE: a verbose
# pass that printed `[DRIFT]` lines and always `exit 0`, then a silent pass that returned the count.
# Only the second fed FAILS. With PyYAML missing, the first printed a [DRIFT] line and the second
# returned 0, so the log looked dirty while the counter, the exit code and the healthchecks ping all
# said CLEAN. A guardian that cannot tell must say so; this one told the human and lied to the machine.
#
# One pass now. It prints its findings and reports the count on a final COUNT= line, so the vocabulary
# and the walk exist once — two copies of the same logic is how they drift apart.
check_frontmatter(){ # <repo> <label>
  local r="$1" n="$2" out rc
  out="$(python3 - "$r" "$n" <<'PY'
import os,sys
try:
    import yaml
except ImportError:
    sys.stderr.write("PyYAML missing\n"); sys.exit(2)
ALLOWED={'skill','decision','policy','memory','tool-registry','template','reference','directory-readme','working-doc'}
R,N=sys.argv[1],sys.argv[2]; bad=0
try:
    walked=False
    for root,dirs,files in os.walk(R):
        walked=True
        # output-styles/: a third OKF exemption (2026-08-25) alongside CLAUDE.md and memory/auto —
        # frontmatter there is Claude Code's own schema (name/description/keep-coding-instructions),
        # parsed live by the harness, not OKF's. Same reasoning as CLAUDE.md: an OKF `type` field
        # would be noise in a schema this checker does not own.
        dirs[:]=[d for d in dirs if d not in ('.git','auto','output-styles')]
        for fn in files:
            if not fn.endswith('.md') or fn=='CLAUDE.md': continue
            p=os.path.join(root,fn)
            try: s=open(p,encoding='utf-8').read()
            except Exception as e:
                bad+=1
                print(f"{N}: {os.path.relpath(p,R)} could not be read ({type(e).__name__}) — unknown, not clean")
                continue
            # A file with NO frontmatter block used to be skipped in silence, so "has no metadata at
            # all" was the one way to pass every metadata assertion. That is the fail-open shape this
            # checker exists to hunt, sitting inside the checker. Absence is not conformance.
            if not s.startswith('---'):
                bad+=1
                print(f"{N}: {os.path.relpath(p,R)} has no frontmatter block at all")
                continue
            try: fm=yaml.safe_load(s.split('---',2)[1])
            except Exception as e:
                bad+=1
                print(f"{N}: {os.path.relpath(p,R)} frontmatter is not valid YAML ({type(e).__name__}) — quote any value containing ': '")
                continue
            # Closed `type` vocabulary. Declared 2026-08-07 and, for one day, declared and not applied:
            # 36 files still carried retired values because nothing asserted it. A vocabulary nothing
            # checks is a preference.
            if isinstance(fm,dict):
                t=fm.get('type')
                if t is None:
                    bad+=1; print(f"{N}: {os.path.relpath(p,R)} has frontmatter but no `type`")
                elif t not in ALLOWED:
                    bad+=1; print(f"{N}: {os.path.relpath(p,R)} has type '{t}', outside the closed vocabulary ({', '.join(sorted(ALLOWED))})")
    # A tree we could not walk at all is "unknown", not "clean" — the zero-iteration fail-open.
    if not walked: sys.stderr.write("tree not walkable\n"); sys.exit(2)
except OSError as e:
    sys.stderr.write(f"walk failed: {e}\n"); sys.exit(2)
print(f"COUNT={bad}")
PY
)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    drift "$n: frontmatter validation could NOT run (PyYAML missing, or the tree is unreadable) — this is unknown, not clean"
    return 0
  fi
  local c; c="$(printf '%s\n' "$out" | sed -n 's/^COUNT=//p' | tail -1)"
  printf '%s\n' "$out" | sed '/^COUNT=/d;/^$/d' | while IFS= read -r l; do echo "  [DRIFT] $l"; done
  if [ -z "$c" ]; then
    drift "$n: frontmatter validation produced no count — treating as unknown"
  elif [ "$c" -gt 0 ]; then
    FAILS=$((FAILS+c)); DRIFT_LOG="${DRIFT_LOG}${DRIFT_LOG:+; }$n: $c file(s) with invalid frontmatter"
  fi
  return 0
}
check_brain(){ # <user> <repo>
  local u="$1" r="$2" n; n="$(basename "$r")"
  echo "== $n =="
  local asu; asu(){ as_agent "$u" "$1"; }

  # Frontmatter is a PROSE assertion, so a dormant agent is exempt — the same reason the reference
  # sweep bails out on a frozen brain further down. This is not squeamishness: a dormant agent's repo
  # is ARCHIVED and therefore read-only, so any finding against it is unactionable by construction,
  # and a permanent unactionable finding is exactly how an alarm channel stops being read. Closing the
  # no-frontmatter fail-open on 2026-08-24 surfaced two of them immediately (both dormant READMEs),
  # which is how this exemption came to be written rather than assumed.
  local _dorm_fm=0; for da in $DORMANT_AGENTS; do [ "$da" = "$u" ] && _dorm_fm=1; done
  [ "$_dorm_fm" = 1 ] || check_frontmatter "$r" "$n"

  # 1) Declared brain shape (v3: one always-on file) + the assertions that keep it honest.
  #
  # v2 split identity across SOUL.md + OPERATING.md and had CLAUDE.md point at them. The 2026-08-07
  # audit measured what that actually loaded: nothing but CLAUDE.md is auto-loaded, and on the fleet's
  # own transcripts the agents read their OPERATING.md in 22–54% of substantial sessions. The gates and
  # the threat model were therefore absent from context most of the time. v3 folds them into CLAUDE.md.
  # So this no longer checks that three files exist — it checks that the ONE file carries the content
  # that must never be merely retrievable.
  [ -f "$r/CLAUDE.md" ] || drift "$n: missing CLAUDE.md — the agent has NO always-on contract"
  for f in SOUL.md OPERATING.md; do
    [ -f "$r/$f" ] && drift "$n: $f still exists — v3 folds it into CLAUDE.md; content here is not loaded by anything"
  done
  if [ -f "$r/CLAUDE.md" ]; then
    # Vocabulary-bearing on purpose (a class-2 assertion): these are the sections whose absence is
    # silent. A missing gate list does not fail anything — it just quietly stops binding.
    #
    # A DORMANT agent is held to a different bar: it has no scope, so gates and an autonomous-OK list
    # would be describing work it must not do. What it must still carry is the untrusted-content rule
    # (it applies to anything that wakes and reads) and an unmissable statement that it is dormant.
    local dorm=0; for da in $DORMANT_AGENTS; do [ "$da" = "$u" ] && dorm=1; done
    if [ "$dorm" = 1 ]; then
      grep -qi 'untrusted' "$r/CLAUDE.md" || drift "$n: CLAUDE.md does not carry the untrusted-content rule"
      grep -qi 'dormant'   "$r/CLAUDE.md" || drift "$n: CLAUDE.md does not say the agent is DORMANT — a woken agent would read a live contract"
    else
      for tok in 'Human-confirm gates:gates' 'untrusted:the untrusted-content prime directive' 'Autonomous-OK:the autonomous-OK list'; do
        grep -qi "${tok%%:*}" "$r/CLAUDE.md" || drift "$n: CLAUDE.md does not carry ${tok##*:} — it binds only if it is in the file the runtime loads"
      done
    fi
    # Size: 4 MiB is the runtime's hard skip and 40k chars its soft threshold (verified in the 2.1.224
    # binary). Warn far earlier — a bloated always-on file is a different failure: it still loads, and
    # everything in it competes for attention with everything else.
    #
    # Count @-imports too. An `@path` in CLAUDE.md is INLINED by the runtime, so the always-on cost is
    # the sum, not the file. Measuring CLAUDE.md alone would let the budget be defeated by moving text
    # one hop away — which is exactly what an import is for, and exactly why it must be counted.
    local cmsz; cmsz=$(wc -c < "$r/CLAUDE.md")
    local imp impsz=0
    while IFS= read -r imp; do
      [ -n "$imp" ] || continue
      # An import that resolves OUTSIDE the project root hits Claude Code's external-includes approval
      # gate (hasClaudeMdExternalIncludesApproved). A systemd topic session cannot answer a prompt, so
      # the import would silently not load and the agent would run without it, with no error anywhere.
      case "$imp" in
        /*|'~'*|../*|*/../*) drift "$n: CLAUDE.md imports '$imp', which resolves outside the repo — the external-includes gate cannot be answered by a non-interactive session, so it would silently fail to load"; continue;;
      esac
      [ -f "$r/$imp" ] && impsz=$((impsz + $(wc -c < "$r/$imp")))
    done < <(grep -oE '(^|[[:space:]])@[A-Za-z0-9._/-]+\.md' "$r/CLAUDE.md" 2>/dev/null | sed 's/^[[:space:]]*@//' | sort -u)
    # The auto-memory INDEX is always-on too, and the budget used to ignore it because it lives
    # outside the repo. Measured 2026-08-22 on the root agent: CLAUDE.md + imports = 16,538 bytes =
    # 3,274 tokens, while the index alone = 8,257 bytes = 3,701 tokens. The layer the budget did not
    # watch cost MORE than the layer it did. A budget that measures the cheaper half is decoration.
    #
    # Derived, not configured: the runtime keys its store by the session's cwd, and supervised topics
    # run with cwd = the agent's home, so the path follows from the home directory. If it is absent
    # the agent simply has no auto-memory yet — that is a legitimate zero, not an unknown.
    local _bhome; _bhome="$(getent passwd "$u" | cut -d: -f6)"
    local memidx="$_bhome/.claude/projects/-$(echo "${_bhome#/}" | tr '/' '-')/memory/MEMORY.md"
    local memsz=0
    [ -f "$memidx" ] && memsz=$(wc -c < "$memidx")
    local total=$((cmsz + impsz + memsz))
    # Reported EVERY run, not only on breach. The index grows by normal operation — every memory the
    # runtime writes adds a line — so the useful signal is the trend, and a number you only see once
    # it is already too late is a number you cannot plan around.
    echo "  [info] $n: always-on ${total}B = CLAUDE.md ${cmsz} + imports ${impsz} + memory index ${memsz} (budget ${CONTEXT_BUDGET})"
    [ "$total" -gt "$CONTEXT_BUDGET" ] && drift "$n: always-on context is ${total} bytes (CLAUDE.md ${cmsz} + imports ${impsz} + auto-memory index ${memsz}) — over the ${CONTEXT_BUDGET} working budget. Shorten the index HOOKS or push reference material out of CLAUDE.md into skills/ — do NOT delete index lines: a memory with no line in MEMORY.md is invisible to recall, which is a loss, not a saving."
  fi

  # 2) Skills: folders with SKILL.md, frontmatter name == dirname, non-empty description.
  local flat; flat="$(find "$r/skills" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' 2>/dev/null)"
  [ -n "$flat" ] && drift "$n: flat skill file(s) — should be <name>/SKILL.md: $(echo "$flat" | tr '\n' ' ')"
  local d nm sk
  for d in "$r"/skills/*/; do
    [ -d "$d" ] || continue
    nm="$(basename "$d")"; sk="$d/SKILL.md"
    [ -f "$sk" ] || { drift "$n: skills/$nm has no SKILL.md (invisible to the harness)"; continue; }
    local fn fd
    fn="$(awk -F': *' '/^name:/{print $2; exit}' "$sk" | tr -d ' \r')"
    fd="$(awk -F': *' '/^description:/{print $2; exit}' "$sk")"
    [ "$fn" = "$nm" ] || drift "$n: skills/$nm frontmatter name='$fn' != folder name"
    [ -n "$fd" ] || drift "$n: skills/$nm has no description (the harness matches on it)"
  done

  # 3) Every symlink in the brain resolves (catches renamed/removed fleet-common skills, shared/).
  local bad
  if ! bad="$(find "$r" -path "$r/.git" -prune -o -type l ! -exec test -e {} \; -print 2>/dev/null)"; then
    drift "$n: could not walk the tree for symlinks — resolution is UNKNOWN, not clean"
  else
    [ -n "$bad" ] && drift "$n: dangling symlink(s): $(echo "$bad" | tr '\n' ' ')"
  fi

  # 4) Runtime registration: ~/.claude/skills must BE a symlink, resolve, and point at this repo.
  local home cs tgt; home="$(getent passwd "$u" | cut -d: -f6)"; cs="$home/.claude/skills"
  if [ ! -L "$cs" ]; then
    drift "$n: ~/.claude/skills is not a symlink (skills invisible or hand-managed)"
  elif [ ! -e "$cs" ]; then
    drift "$n: ~/.claude/skills is a DANGLING symlink (all skills invisible to the harness)"
  else
    tgt="$(readlink -f "$cs")"
    [ "$tgt" = "$(readlink -f "$r/skills")" ] || drift "$n: ~/.claude/skills points at $tgt, not $r/skills"
  fi

  # 5) Clone agrees with origin — catches silent push failures and chronic kb-sync skips.
  if ! asu "cd '$r' && git remote update -p >/dev/null 2>&1"; then
    # Without this, an expired token or a network failure leaves ahead/behind computed against stale
    # refs — both 0 — so the check built to catch silent push failure fails silently itself.
    drift "$n: could not fetch from origin (expired token? network?) — sync state is UNKNOWN, not clean"
  fi
  # A branch with NO upstream made both counts come out 0 — `git rev-list @{u}..HEAD` errors, stderr
  # was discarded, `|| echo 0` supplied the reassuring answer. So an agent that ran `git checkout -b`
  # got a repo that kb-sync freezes (pull --ff-only also fails) AND that this check certified clean.
  # Verified. Ask about the upstream first and treat its absence as drift in its own right.
  local ahead behind branch
  if ! asu "cd '$r' && git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1"; then
    branch="$(asu "cd '$r' && git rev-parse --abbrev-ref HEAD 2>/dev/null" || echo '?')"
    drift "$n: branch '$branch' has no upstream — sync state is UNKNOWN and kb-sync skips this repo"
  else
    # `|| echo 0` used to make a FAILED rev-list indistinguishable from "0 commits ahead" — i.e. a
    # broken repo read as a synced one. Empty now means the command failed, and that drifts.
    ahead="$(asu "cd '$r' && git rev-list --count '@{u}..HEAD' 2>/dev/null" || true)"
    behind="$(asu "cd '$r' && git rev-list --count 'HEAD..@{u}' 2>/dev/null" || true)"
    if [ -z "$ahead" ] || [ -z "$behind" ]; then
      drift "$n: git rev-list failed — sync state is UNKNOWN, not clean"
    else
      [ "$ahead" -gt 0 ] && drift "$n: $ahead commit(s) unpushed (push failing? clone diverging)"
      [ "$behind" -gt 0 ] && drift "$n: $behind commit(s) behind origin (kb-sync skipping this repo?)"
    fi
  fi

  # --- The topic registry is versioned state that a CLI mutates, so it drifts in three ways ---
  # (uncommitted / not matching HEAD / not matching the units actually enabled). All three were live
  # on 2026-07-29: claude-topic wrote deploy/topics.tsv and never committed it, so every agent's
  # declaration had quietly diverged from the sessions really running, and a reprovision would have
  # reverted them.
  local reg="$r/deploy/topics.tsv"
  if [ ! -f "$reg" ]; then
    drift "$n: no deploy/topics.tsv — provision-agent would recreate no topics on a rebuilt box"
  else
    asu "cd '$r' && git ls-files --error-unmatch -- deploy/topics.tsv >/dev/null 2>&1" \
      || drift "$n: deploy/topics.tsv is not tracked in git — topic changes are lost on reprovision"
    asu "cd '$r' && git diff --quiet HEAD -- deploy/topics.tsv 2>/dev/null" \
      || drift "$n: deploy/topics.tsv differs from HEAD (uncommitted topic change — claude-topic's commit failed?)"
    # Registry vs the units systemd actually has enabled, both directions.
    #
    # NB on enumeration: `systemctl --user list-unit-files 'claude-topic@*.service'` returns NOTHING
    # for a template's instances (verified) — it lists unit FILES, and an instance has none. So the
    # registry direction asks `is-enabled` per key, and the reverse direction reads the
    # `*.target.wants/` symlinks that `systemctl enable` actually creates. An earlier version of this
    # check used list-unit-files and reported all four agents as having no enabled topics while every
    # one of them was active — a false positive that would have trained everyone to ignore this check.
    # topics.tsv is AGENT-WRITABLE, so every key read out of it is untrusted input being handled by
    # root's shell. The first version of this block iterated `for k in $reg_keys` unquoted and
    # interpolated `$k` straight into the `bash -c` string. All three consequences were reproduced:
    # a key of `*` glob-expanded against the checker's cwd, `has space` split into two keys, and a key
    # of `x'; echo INJECTED; true; :'` EXECUTED that code inside the inner shell. It runs as the agent,
    # not root, so it is not privilege escalation — but the payoff is worse in context: a crafted key
    # makes the is-enabled assertion below return 0 and thereby SUPPRESSES ITS OWN DRIFT FINDING. That
    # is the "agents can lie to the checker" property this script's `as_agent` hardening exists to
    # close, walked in through a second door.
    # claude-topic already solved this (see its `reg_keys()`): filter to a known-safe charset and warn
    # on anything else. Same rule here, plus `read` instead of word-splitting, plus the key passed as
    # a positional argument rather than interpolated into the script text.
    local reg_keys unit_keys home_dir k
    home_dir="$(getent passwd "$u" | cut -d: -f6)"
    reg_keys="$(awk -F'\t' '$1 !~ /^[[:space:]]*(#|$)/ {print $1}' "$reg" \
      | grep -xE '[A-Za-z0-9._-]+' | sort -u)"
    local badkeys; badkeys="$(awk -F'\t' '$1 !~ /^[[:space:]]*(#|$)/ {print $1}' "$reg" \
      | grep -vxE '[A-Za-z0-9._-]+' | tr '\n' ' ')"
    [ -n "${badkeys// /}" ] && drift "$n: deploy/topics.tsv has invalid topic key(s) — refusing to act on them: $badkeys"
    if ! as_agent "$u" 'export XDG_RUNTIME_DIR=/run/user/$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
        systemctl --user show-environment >/dev/null 2>&1'; then
      drift "$n: user manager unreachable for '$u' (linger off?) — topic enablement is UNKNOWN, not clean"
    else
      while IFS= read -r k; do
        [ -n "$k" ] || continue
        runuser -u "$u" -- env PATH="$AGENT_PATH" bash --noprofile --norc -c \
          'export XDG_RUNTIME_DIR=/run/user/$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
           systemctl --user is-enabled --quiet "claude-topic@$1.service" 2>/dev/null' _ "$k" \
          || drift "$n: topic '$k' is in the registry but its unit is not enabled (provisioning half-applied)"
      done <<< "$reg_keys"
    fi
    unit_keys="$(ls "$home_dir"/.config/systemd/user/*.target.wants/claude-topic@*.service 2>/dev/null \
      | sed 's#.*/claude-topic@##;s#\.service$##' | sort -u)"
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      # -F: the key is data, not a pattern. Without it `foo.bar` matches a registry line `fooxbar`
      # and an unregistered unit is wrongly accepted. Reproduced.
      grep -qxF "$k" <<< "$reg_keys" \
        || drift "$n: topic unit '$k' is enabled but absent from the registry (it will not survive a reprovision)"
    done <<< "$unit_keys"
    # A topic can be enabled, running, and still have NO stored sessionId — ~/.config/agent/topics.state
    # is runtime state that only `claude-topic new/remember/stop/restart` writes. Provisioning used to
    # leave exactly that state (fixed 2026-08-01), and nothing anywhere could see it: the next reboot
    # would start a BLANK conversation and orphan the history (the 2026-07-17 incident class). The
    # monitor only asks is-active, so this is the one place that can assert it. Missing file = every
    # enabled topic is unanchored, which is precisely the case worth shouting about.
    local state_file="$home_dir/.config/agent/topics.state"
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      awk -F'\t' -v key="$k" '$1==key && $2 ~ /^[0-9a-fA-F-]{36}$/ {f=1} END{exit !f}' "$state_file" 2>/dev/null \
        || drift "$n: topic '$k' is enabled but has NO stored sessionId — a restart or reboot would start a BLANK conversation and orphan its history (fix: claude-topic remember $k)"
    done <<< "$unit_keys"
  fi

  # A dormant brain is a frozen snapshot: its prose and its bootstrap point at a world that has moved
  # on, and fixing paths in a repo nobody may write (often archived) buys nothing. Everything above
  # this line still applies to it — including that it must say DORMANT.
  local _dorm_ref=0; for da in $DORMANT_AGENTS; do [ "$da" = "$u" ] && _dorm_ref=1; done
  if [ "$_dorm_ref" = 1 ]; then return 0; fi

  # 6) The live entry point resolves. Cheap and load-bearing: the runtime reads ~/CLAUDE.md, and
  #    it silently lagged the repo during the v2 migration until provision-agent re-ran.
  local hc="$home/CLAUDE.md"
  if [ ! -e "$hc" ]; then drift "$n: ~/CLAUDE.md missing or dangling (agent boots with no bootstrap)"
  else
    # ONE layout (2026-07-30): ~/CLAUDE.md must resolve to the brain's root CLAUDE.md — the single
    # bootstrap. (The three-layer deploy/home-CLAUDE.md variant was dropped; see provision-agent.)
    local got
    got="$(readlink -f "$hc")"
    [ "$got" = "$(readlink -f "$r/CLAUDE.md" 2>/dev/null)" ] \
      || drift "$n: ~/CLAUDE.md resolves to '$got', not $r/CLAUDE.md (the single supported bootstrap)"
    while IFS= read -r f; do
      [ -e "$r/$f" ] || drift "$n: ~/CLAUDE.md bootstrap names a missing file: $f"
    done < <(grep -oE '[A-Za-z0-9_/.-]+\.md' "$hc" 2>/dev/null | grep -v '^CLAUDE.md$' | sed "s#.*kb-agent-[A-Za-z0-9-]*/##" | sort -u)
  fi

  # 7) Referenced paths exist. Vocabulary-free and self-maintaining: renames/removals self-report.
  #    Active docs only — decisions/, handoffs/ and memory/ are history and may cite removed files.
  # NB: capture to a variable — piping into the loop would run `drift` in a subshell and lose
  # the failure count (a fail-open the first version of this check actually had).
  local refbad; refbad="$(MD_BASE="$(dirname "$r")" REPO="$r" python3 - "$u" <<'PY'
import os,re,subprocess,sys
repo=os.environ["REPO"]; base=os.environ["MD_BASE"]; n=os.path.basename(repo)
# Fail CLOSED on "cannot list". subprocess.run does NOT raise on a non-zero exit, so a repo we
# cannot read used to come back as an empty file list — indistinguishable from a repo with nothing
# wrong. "I could not look" must not render as "I looked and it was fine".
try:
    _p=subprocess.run(["runuser","-u",sys.argv[1],"--","git","-C",repo,"ls-files","*.md"],
                      capture_output=True,text=True,timeout=60)
    if _p.returncode != 0:
        print(f"{n}: reference check could NOT list files (git ls-files exit {_p.returncode}) — unknown, not clean")
        sys.exit(0)
    files=_p.stdout.split()
except Exception as e:
    print(f"{n}: reference check could NOT run ({type(e).__name__}) — unknown, not clean")
    sys.exit(0)
if not files:
    print(f"{n}: reference check found no .md files at all — unknown, not clean")
    sys.exit(0)
skip=("decisions/","handoffs/","memory/")
# Backticked candidates must contain a '/': a bare `SKILL.md` or `ui.json` in prose names a
# kind of file, not a link to one. Markdown links are checked as written.
pat=re.compile(r'\]\(([^)\s#][^)\s]*)\)|`([A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+\.(?:md|json|tsv|sh|py|service|timer))`')
bad=set()
for f in files:
    if f.startswith(skip): continue
    p=os.path.join(repo,f)
    try: txt=open(p,encoding="utf-8",errors="ignore").read()
    except Exception: continue
    for m in pat.finditer(txt):
        ref=(m.group(1) or m.group(2) or "").strip()
        if not ref or ref.startswith(("http","mailto:","#","/",".claude",".mcp")) or any(c in ref for c in "<>*$ "): continue
        ref=ref.split("#")[0]
        if not ref or "/" not in ref: continue
        cands=[os.path.join(os.path.dirname(p),ref), os.path.join(repo,ref), os.path.join(base,ref)]
        if not any(os.path.exists(c) for c in cands): bad.add(f"{f} -> {ref}")
for b in sorted(bad): print(f"{n}: broken reference: {b}")
PY
)"
  if [ -n "$refbad" ]; then
    while IFS= read -r l; do [ -n "$l" ] && drift "$l"; done <<< "$refbad"
  fi

  # 7b) DORMANT AGENTS NAMED AS LIVE ACTORS. The gap this check did not have on 2026-08-22, when it
  #     reported 0 drift twice while a dormant agent was named as the active owner of the application
  #     layer in nine files, an access matrix handed production write to its revoked bot, and a
  #     runbook said to hand it a token.
  #
  #     It stays vocabulary-free in the sense that matters: the NAMES are derived from the roster and
  #     the dormant file, so adding or waking an agent needs no edit here. The only literal list is a
  #     handful of English tense markers — those describe grammar, not technology, and grammar does
  #     not rot. A dormant agent may appear in an active doc; it may not appear in the present tense.
  #
  #     Scope is active prose only. decisions/, memory/ and archive/ are history by definition and a
  #     record that could not name a dormant agent would be useless.
  if [ -n "${DORMANT_AGENTS// /}" ]; then
    local stale
    stale="$(REPO="$r" DORM="$DORMANT_AGENTS" python3 - "$u" <<'PY'
import os,re,subprocess,sys
repo=os.environ["REPO"]; n=os.path.basename(repo)
names=[d for d in os.environ["DORM"].split() if d]
if not names: sys.exit(0)
try:
    _p=subprocess.run(["runuser","-u",sys.argv[1],"--","git","-C",repo,"ls-files","*.md"],
                      capture_output=True,text=True,timeout=60)
    if _p.returncode!=0:
        print(f"{n}: dormant-actor check could NOT list files (git ls-files exit {_p.returncode}) — unknown, not clean"); sys.exit(0)
    files=_p.stdout.split()
except Exception as e:
    print(f"{n}: dormant-actor check could NOT run ({type(e).__name__}) — unknown, not clean"); sys.exit(0)
skip=("decisions/","memory/","archive/","CHANGELOG")
# Tense/status markers. Small, and about grammar rather than technology, which is why it is allowed
# to be a literal list: it does not need maintaining when the fleet changes.
PAST=re.compile(
    r"dormant|dormiente|archiv|former|superseded|historical|storic|previously|no longer|used to"
    r"|until |since |was |were |had |inherit|absorbed|folded|provenance|migrat|retired|sleep|asleep"
    # Attribution and dates read as history: "Added by X", "Cut by X on 2026-08-03". A line that
    # credits past work is not a line that routes future work.
    r"|\b(?:added|cut|wrote|authored|built|created|shipped|introduced|handed|owned|ran|left)\b"
    r"|\d{4}-\d{2}-\d{2}|\b(?:19|20)\d{2}\b", re.I)
bad=[]
for f in files:
    if f.startswith(skip) or os.path.basename(f).startswith("CHANGELOG"): continue
    try: txt=open(os.path.join(repo,f),encoding="utf-8",errors="ignore").read()
    except Exception: continue
    for i,line in enumerate(txt.splitlines(),1):
        for nm in names:
            if re.search(rf"\b{re.escape(nm)}\b", line, re.I) and not PAST.search(line):
                bad.append(f"{f}:{i} names dormant agent '{nm}' with no past-tense or dormancy marker")
                break
for b in bad[:20]: print(f"{n}: {b}")
if len(bad)>20: print(f"{n}: ... and {len(bad)-20} more line(s) naming a dormant agent in the present tense")
PY
)"
    if [ -n "$stale" ]; then
      while IFS= read -r l; do [ -n "$l" ] && drift "$l"; done <<< "$stale"
    fi
  fi

  # 8) PER-AGENT INSTALLED ARTIFACTS. installed.manifest only covers root-installed paths, but
  #    provision-agent also materialises two per-agent files as REAL COPIES — deliberately, so they do
  #    not live-follow the auto-synced repos (findings F1/F3). A real copy is exactly what silently
  #    goes stale: edit the source, and every agent keeps the old one until someone re-runs
  #    provisioning, with nothing saying so. Same "edited the repo, forgot to re-install" class the
  #    root manifest exists for, one directory down.
  #    settings.json is the PERMISSION ALLOWLIST, so this is the highest-value of the two.
  local dep="$r/deploy/claude-settings.json" liveset="$home/.claude/settings.json"
  if [ ! -f "$dep" ]; then
    drift "$n: no deploy/claude-settings.json — ~/.claude/settings.json (the permission allowlist) is unversioned and compared against nothing"
  elif [ ! -f "$liveset" ]; then
    drift "$n: ~/.claude/settings.json is MISSING though deploy/claude-settings.json exists (provisioning never applied it)"
  elif ! cmp -s "$dep" "$liveset"; then
    drift "$n: ~/.claude/settings.json differs from deploy/claude-settings.json — re-run provision-agent (permission allowlist is stale)"
  fi
  # (settings.local.json is deliberately NOT checked: per-machine, auto-accumulated, git-ignored.)
  local liveunit="$home/.config/systemd/user/claude-topic@.service"
  local srcunit="${INFRA_DIR}/systemd/claude-topic@.service"
  if [ ! -f "$liveunit" ]; then
    drift "$n: ~/.config/systemd/user/claude-topic@.service is missing — no topic can start"
  elif [ -f "$srcunit" ] && ! cmp -s "$srcunit" "$liveunit"; then
    drift "$n: claude-topic@.service differs from $srcunit — re-run provision-agent"
  fi
  # Any OTHER per-agent systemd user unit the brain declares (deploy/*.service|*.timer, e.g.
  # an MCP server service). Two assertions: the installed copy matches the declared source
  # (same stale-real-copy class as settings.json), and — the reverse — no *enabled* user service
  # exists that the brain does not declare. The reverse direction is what catches the original
  # sin: a hand-crafted unit living only on the box, which a rebuild silently loses. Enabled-only
  # (default.target.wants), so transient/systemd-internal user units don't false-positive; the
  # claude-topic@ instances have their own dedicated checks above.
  local dsrc dlive uname
  for dsrc in "$r"/deploy/*.service "$r"/deploy/*.timer; do
    [ -f "$dsrc" ] || continue
    uname="$(basename "$dsrc")"
    # claude-topic@ and rotate-on-boot are installed by provision-agent FROM INFRA, not declared in
    # the agent's deploy/ — they are fleet code, not per-agent config, so "not in deploy/" is correct
    # for them, not drift. rotate-on-boot landed in 0.6.5 and this exclusion was never extended, so it
    # reported every agent every day since.
    case "$uname" in claude-topic@*|claude-topic-rotate-on-boot.service) continue;; esac
    dlive="$home/.config/systemd/user/$uname"
    if [ ! -f "$dlive" ]; then
      drift "$n: deploy/$uname is declared but not installed to ~/.config/systemd/user/ (service missing on this box)"
    elif ! cmp -s "$dsrc" "$dlive"; then
      drift "$n: ~/.config/systemd/user/$uname differs from deploy/$uname — stale real copy, re-install it"
    fi
  done
  while IFS= read -r uname; do
    [ -n "$uname" ] || continue
    # claude-topic@ and rotate-on-boot are installed by provision-agent FROM INFRA, not declared in
    # the agent's deploy/ — they are fleet code, not per-agent config, so "not in deploy/" is correct
    # for them, not drift. rotate-on-boot landed in 0.6.5 and this exclusion was never extended, so it
    # reported every agent every day since.
    case "$uname" in claude-topic@*|claude-topic-rotate-on-boot.service) continue;; esac
    [ -f "$r/deploy/$uname" ] \
      || drift "$n: user unit '$uname' is enabled but not declared in deploy/ — it exists only on this box and will NOT survive a rebuild"
  done < <(find "$home"/.config/systemd/user/ -path '*.target.wants/*' \
             \( -name '*.service' -o -name '*.timer' \) -printf '%f\n' 2>/dev/null | sort -u)

  # 9) Linger. The single switch that decides whether this agent survives a reboot at all. Previously
  #    only inferred, and only when the user manager happened to be unreachable at check time.
  loginctl show-user "$u" --property=Linger 2>/dev/null | grep -q 'Linger=yes' \
    || drift "$n: linger is OFF for '$u' — its topics will NOT come back after a reboot"
}

# Iterate the UNION of roster and discovered: a brain missing from the roster already drifted
# above, and still deserves its per-brain checks rather than a blind spot.
for u in $ALL_AGENTS; do
  # `getent | cut` exits with cut's status, always 0, so a roster name with no Unix user used to
  # fall through with an EMPTY home and report "no brain repo found under /github/<org>/" — a path
  # that does not exist and does not name the real problem. Same dead-`||` idiom already fixed in
  # kb-sync, memory-mirror and provision-agent; this was the fourth copy. Ask getent.
  if ! getent passwd "$u" >/dev/null; then
    drift "$u: listed in the roster but there is no such Unix user (roster typo, or a teardown that skipped the roster)"
    continue
  fi
  base="$(getent passwd "$u" | cut -d: -f6)/github"
  # >1 candidate is ambiguous, and `head -1` would silently pick one — see memory-mirror for why
  # guessing here is not safe. claude-topic refuses in the same situation; so do we.
  mapfile -t _brains < <(ls -d "$base"/*/kb-agent-*-"$u" 2>/dev/null)
  if [ "${#_brains[@]}" -gt 1 ]; then
    drift "$u: multiple candidate brain repos under $base (${_brains[*]}) — refusing to guess which is real; rename or remove the stale one"
    continue
  fi
  brain="${_brains[0]:-}"
  if [ -n "$brain" ] && [ -d "$brain/.git" ]; then check_brain "$u" "$brain"; else drift "$u: no brain repo found under $base/<org>/"; fi
done

# --- installed artifacts still match their repo source (catches "edited the repo, forgot to
# --- re-run the installer" — a whole class that no other check can see) ---
echo "== installed artifacts =="
MAN="/usr/local/share/agentic/installed.manifest"
if [ -f "$MAN" ]; then
  while IFS='|' read -r dst src; do
    [ -n "$dst" ] || continue
    # The manifest records ABSOLUTE source paths from whichever clone ran the installer. Run it from a
    # different path and every later comparison points at a source that may not exist — which would
    # otherwise surface as a confusing "differs from <nonexistent>" forever.
    if [ ! -e "$src" ]; then drift "installed: manifest source $src does not exist (installer was run from a different clone path) — re-run install-host-services from the canonical clone"
    elif [ ! -e "$dst" ]; then drift "installed: $dst is MISSING (source $src)"
    elif ! cmp -s "$dst" "$src"; then drift "installed: $dst differs from $src — re-run install-host-services"
    fi
  done < "$MAN"
else
  echo "  [warn] no $MAN — run install-host-services to generate it"
fi

# Anything sitting in the agentic state dir that the manifest does NOT account for. The manifest
# check above is one-directional by construction: it iterates rows IN the manifest, so it proves
# "everything installed is listed" and says nothing about "everything present is listed". That gap
# hid a root-owned mode-0600 `installed.manifest.XXXXXX` left by an aborted installer run — beside
# the file this very loop reads, and invisible to it.
# Deliberately scoped to /usr/local/share/agentic (a directory this tooling owns outright) and NOT
# to /usr/local/bin, which is shared with the rest of the system: sweeping there would flag every
# unrelated binary a host legitimately has, i.e. a check that costs more than it detects.
if [ -d /usr/local/share/agentic ] && [ -f "$MAN" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # The manifest cannot list itself (it records what `inst()` installed, and it is not installed
    # by inst()) — skipping it is not an exception carved out to make a run pass, it is the one
    # file whose absence from its own inventory is correct by construction. Caught by this very
    # check false-positiving on a healthy fleet the first time it ran.
    [ "$f" = "$MAN" ] && continue
    grep -qxF "$f" <(awk -F'|' '{print $1}' "$MAN" 2>/dev/null) \
      || drift "installed: $f is in /usr/local/share/agentic but not in the manifest — leftover from an aborted install, or something installed by hand; remove it or install it properly"
  done < <(find /usr/local/share/agentic -maxdepth 1 -type f 2>/dev/null | sort)
fi

# AGENT_PATH is defined identically in four scripts (this one, memory-mirror, provision-agent,
# agentic-monitor) — deliberately NOT factored into a shared lib (a new installed moving part) and
# deliberately NOT including any agent-writable dir (see provision-agent's comment on the
# planted-binary trade). Duplication is fine; SILENT divergence between the copies is not — one
# script quietly running agents' commands with a different PATH than its siblings is exactly the
# class this checker exists for. Assert the four definitions are still one.
if [ ! -d "$INFRA_DIR" ]; then
  drift "installed: no infra clone found (manifest missing or moved) — AGENT_PATH and per-agent unit sources cannot be verified"
else
# INFRA_DIR is this checker's root of trust: every "installed artifact still matches its source"
# comparison, the AGENT_PATH assertion and the per-agent unit comparison all resolve through it, and
# it is whatever path last ran install-host-services. So a run from a throwaway clone silently
# re-points the checker at that clone — and then "installed matches source" compares the odd install
# against the odd source and agrees. The supporting-repos sweep below audits clones under a fleet
# agent's ~/github/<org>/ (clean, pushed, not behind); a clone OUTSIDE that tree is audited by
# nothing at all. Assert that the root of trust is one of the repos this checker actually vets.
_infra_audited=0
for _u in $ALL_AGENTS; do
  getent passwd "$_u" >/dev/null || continue
  case "$INFRA_DIR/" in "$(getent passwd "$_u" | cut -d: -f6)"/github/*) _infra_audited=1; break;; esac
done
[ "$_infra_audited" = 1 ] || drift "installed: the manifest says the host services were installed from '$INFRA_DIR', which is not inside any fleet agent's ~/github/<org>/ — that clone is audited by nothing (not its cleanliness, not whether it is pushed), yet it is the source every 'installed matches source' comparison trusts. Re-run install-host-services from the canonical infra clone."
# Assert the four files EXIST before comparing them. The old form counted the distinct values it
# found: three missing files plus one present gave one variant, i.e. "they agree". Only the
# 0-of-4 case drifted. Absence is not agreement — this is the same fail-open shape as an empty
# list reading as a clean one.
_AP_FILES="agentic-divergence-check memory-mirror provision-agent agentic-monitor"
_ap_missing=""
for _f in $_AP_FILES; do
  [ -f "$INFRA_DIR/scripts/$_f" ] || _ap_missing="$_ap_missing $_f"
done
if [ -n "$_ap_missing" ]; then
  drift "installed: cannot compare AGENT_PATH — missing from '$INFRA_DIR/scripts':$_ap_missing. The comparison would have counted the survivors and called them unanimous."
else
  _ap_defined=0
  for _f in $_AP_FILES; do
    grep -q '^AGENT_PATH=' "$INFRA_DIR/scripts/$_f" && _ap_defined=$((_ap_defined+1))
  done
  if [ "$_ap_defined" -ne 4 ]; then
    drift "installed: only $_ap_defined of the 4 infra scripts define AGENT_PATH — one of them silently inherits the caller's PATH"
  else
    AP_COUNT="$(grep -h '^AGENT_PATH=' \
      "$INFRA_DIR/scripts/agentic-divergence-check" "$INFRA_DIR/scripts/memory-mirror" \
      "$INFRA_DIR/scripts/provision-agent" "$INFRA_DIR/scripts/agentic-monitor" | sort -u | grep -c .)"
    [ "${AP_COUNT:-0}" = 1 ] || drift "installed: AGENT_PATH definitions across the four infra scripts are not identical (found $AP_COUNT variants) — re-align them; a diverged PATH silently changes what runs as the agents"
  fi
fi
fi

# --- timers that must be enabled (a job silently switched off is not a failed unit) ---
# This is the class that produced the reference deployment's fourth-agent gap: a NEVER-enabled templated instance never runs, so
# it never becomes a failed unit either, so no failed-unit sweep can see it. The only way to catch it
# is to assert the expectation — and to DERIVE that expectation from the roster, so that adding an
# agent automatically widens what is checked instead of opening a hole.
echo "== host timers =="
for t in kb-sync.timer agentic-monitor.timer agentic-divergence-check.timer; do
  systemctl is-enabled --quiet "$t" 2>/dev/null || drift "timer $t is not enabled"
done
for u in $ALL_AGENTS; do
  dormant=0; for da in $DORMANT_AGENTS; do [ "$da" = "$u" ] && dormant=1; done
  if [ "$dormant" = 1 ]; then
    # Inverted for a dormant agent: the mirror must be OFF. Its brain repo is typically archived, so
    # if the mirror ever had something to push it would fail nightly and page — the daily alarm that
    # retiring the agent was supposed to end.
    systemctl is-enabled --quiet "memory-mirror@${u}.timer" 2>/dev/null \
      && drift "timer memory-mirror@${u}.timer is ENABLED for dormant agent '$u' — it writes nightly to an archived repo; disable it"
  else
    systemctl is-enabled --quiet "memory-mirror@${u}.timer" 2>/dev/null \
      || drift "timer memory-mirror@${u}.timer is not enabled — '$u' has NO durable memory and nothing else would report it"
  fi
done
# The reverse: a timer left enabled for a user who is no longer in the fleet fires and fails nightly,
# which trains everyone to ignore the failure. Catches a teardown done by hand (see the REMOVE
# checklist in the manage-agents skill — the step everyone forgets).
#
# Enumerate with `list-units`, NOT `list-unit-files`. list-unit-files lists unit FILES, and a template
# instance has none: `list-unit-files 'memory-mirror@*.timer'` returns only the TEMPLATE, whose state
# is `indirect`, so `--state=enabled` filtered it out and this loop was DEAD CODE that could never
# fire. Verified on systemd 255 with all four instances enabled. This is the same mistake that had
# already been caught and fixed for the --user case above (see the NB on enumeration) — reintroduced
# one section down, and invisible because a check that never fires looks exactly like a check that
# passes. Any new assertion here needs a deliberately-broken fixture proving it fires; a CLEAN run is
# not evidence.
while IFS= read -r inst; do
  [ -n "$inst" ] || continue
  # -F: the instance name is data. Without it `foo.bar` would match a roster line `fooxbar`.
  grep -qxF "$inst" <<< "$ALL_AGENTS" \
    || drift "timer memory-mirror@${inst}.timer is enabled but '$inst' is neither in the roster nor on disk (stale teardown?)"
done < <(systemctl list-units 'memory-mirror@*.timer' --all --no-legend --plain 2>/dev/null \
          | awk '{print $1}' | sed 's/^memory-mirror@//;s/\.timer$//')

# --- non-brain repos: sync state only. The linter's other checks are brain-shaped, but a frozen
# --- shared/infra clone silently stops governance updates or leaves root-installed code unpushed. ---
echo "== supporting repos =="
for u in $ALL_AGENTS; do
  getent passwd "$u" >/dev/null || continue
  h="$(getent passwd "$u" | cut -d: -f6)"
  for r in "$h"/github/*/*/; do
    case "$(basename "$r")" in kb-agent-*-"$u") continue;; esac
    [ -d "$r/.git" ] || continue
    rname="$(basename "$r")"
    runuser -u "$u" -- git -C "$r" remote update -p >/dev/null 2>&1 || { drift "$rname [$u]: fetch failed — sync state UNKNOWN"; continue; }
    # Same no-upstream fail-open as the brain check: both counts came out 0 and looked clean.
    if ! runuser -u "$u" -- git -C "$r" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      drift "$rname [$u]: branch has no upstream — sync state UNKNOWN and kb-sync skips it"
    else
      # Same shape as the brain check above: a failed rev-list must not render as "in sync".
      a="$(runuser -u "$u" -- git -C "$r" rev-list --count '@{u}..HEAD' 2>/dev/null || true)"
      b="$(runuser -u "$u" -- git -C "$r" rev-list --count 'HEAD..@{u}' 2>/dev/null || true)"
      if [ -z "$a" ] || [ -z "$b" ]; then
        drift "$rname [$u]: git rev-list failed — sync state is UNKNOWN, not clean"
      else
        [ "$a" -gt 0 ] && drift "$rname [$u]: $a commit(s) unpushed"
        [ "$b" -gt 0 ] && drift "$rname [$u]: $b commit(s) behind origin (kb-sync skipping it?)"
      fi
    fi
    # Dirty worktree, for the repos where dirty is never work-in-progress (see STRICT_CLEAN_REPOS).
    # This is the assertion that stops provision-agent's "COMMIT AND PUSH the roster" from becoming
    # the next unenforced manual step — the exact class this tooling exists to remove.
    # Check the shared clone once, not once per agent — they are the same commit. Gate on a flag, NOT
    # on "is this the first roster line": the roster's first line is a comment, so that test could
    # never be true and this assertion silently never ran (found 2026-08-07 — a clean run again looked
    # exactly like a passing one).
    if [ "$rname" = "kb-agent-shared" ] && [ -z "${_shared_fm_checked:-}" ]; then
      _shared_fm_checked=1; check_frontmatter "$r" "$rname"
    fi
    # Released in prose, never tagged. A CHANGELOG head with no matching tag means the version
    # exists only as text: `git describe` and the GitHub releases page both still say the old one,
    # so adopters pinning a tag silently never receive the release. Nothing else surfaces this —
    # the tree is clean and in sync, which is exactly why it went unnoticed until the 2026-08-06
    # audit found three untagged releases. Only repos that already tag are held to it.
    if [ -f "$r/CHANGELOG.md" ]; then
      chv="$(runuser -u "$u" -- sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' "$r/CHANGELOG.md" 2>/dev/null | head -1)"
      tagv="$(runuser -u "$u" -- git -C "$r" tag -l 'v*' --sort=-v:refname 2>/dev/null | head -1)"
      tagv="${tagv#v}"
      # An EMPTY $tagv legitimately means "this repo does not tag" — that is the documented scope.
      # An empty $chv with the file present is different: the CHANGELOG is there and unparseable,
      # which is cannot-tell, not nothing-to-report.
      if [ -z "$chv" ]; then
        drift "$rname [$u]: CHANGELOG.md exists but no '## [x.y.z]' head parses — version currency UNKNOWN"
      elif [ -n "$tagv" ] && [ "$chv" != "$tagv" ]; then
        drift "$rname [$u]: CHANGELOG head $chv but latest tag v$tagv — release(s) untagged"
      fi
    fi
    strict=0; for scr in $STRICT_CLEAN_REPOS; do [ "$scr" = "$rname" ] && strict=1; done
    # exact-token match, not `grep -w`: with -w a repo named "shared" would match inside
    # "kb-agent-shared" (hyphen is a non-word char) and be wrongly held to the strict rule.
    if [ "$strict" = 1 ]; then
      # `[ -n "$x" ] && drift` reports on NON-empty, so an empty $porcelain covers both "clean" and
      # "git status failed" — the second read as the first until 2026-08-25. Ask git whether it could
      # answer, separately from what it answered.
      if ! runuser -u "$u" -- git -C "$r" status --porcelain >/dev/null 2>&1; then
        drift "$rname [$u]: 'git status' failed — worktree cleanliness is UNKNOWN, not clean"
      else
        porcelain="$(runuser -u "$u" -- git -C "$r" status --porcelain 2>/dev/null | head -5 | tr '\n' ' ')"
        [ -n "${porcelain// /}" ] && drift "$rname [$u]: uncommitted changes ($porcelain) — root-installed code or governance left local-only; kb-sync will skip this repo once origin touches the same files"
      fi
    fi
  done
done

echo "== updates =="
updates=0

# --- OS ---
# A broken apt used to render as a patched box: `apt list` failing gave grep an empty stdin, grep -c
# said 0, and "0 upgradable (0 security)" is indistinguishable from "fully patched". Exit 0, healthchecks
# pinged OK, and the security-update detector was dead behind a green dead-man's switch. Proven on
# 2026-08-23 with stub binaries. Now: cannot tell => drift.
apt-get update -qq >/dev/null 2>&1 || true
_aptlist="$(apt list --upgradable 2>/dev/null)"; _aptrc=$?
if [ "$_aptrc" -ne 0 ]; then
  drift "updates: 'apt list --upgradable' failed (rc=$_aptrc) — the OS update count is UNKNOWN, not zero"
  upg="?"; sec=0
else
  upg=$(printf '%s\n' "$_aptlist" | grep -c '/'); upg=${upg:-0}
  sec=$(printf '%s\n' "$_aptlist" | grep -ci -E 'security|-esm-'); sec=${sec:-0}
fi
reboot=no; [ -f /var/run/reboot-required ] && reboot=yes
# Alarm only on actionable items: pending SECURITY updates (unattended-upgrades should auto-apply — if
# still pending it's worth flagging). upgradable-count and reboot-required are REPORTED, not alarmed
# (non-security is low-urgency; the reboot is deferred by choice and Livepatch covers the kernel).
[ "${sec:-0}" -gt 0 ] && updates=1
os="OS: ${upg} upgradable (${sec} security), reboot-required=${reboot}"

# --- Dokploy (running version vs latest GitHub release) ---
cur=$(docker service inspect dokploy --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}' 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)
latest=$(curl -fsS -m 15 https://api.github.com/repos/Dokploy/dokploy/releases/latest 2>/dev/null \
         | grep -oE '"tag_name"[^,]*' | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)
dok="Dokploy: ${cur:-?}"
# Same shape as the apt block above: an empty $cur (docker down) or an empty $latest (network or the
# GitHub API) used to fall into the else and report "(latest ?)" while leaving updates=0 — a silent
# "no update available" produced by not having looked. Absence is not agreement.
if [ -z "$cur" ]; then
  drift "updates: cannot read the running Dokploy version (docker unreachable?) — currency is UNKNOWN"
  dok="$dok (running version unknown)"
elif [ -z "$latest" ]; then
  drift "updates: cannot reach the Dokploy releases API — currency is UNKNOWN, not up to date"
  dok="$dok (latest unknown)"
elif [ "$cur" != "$latest" ]; then
  dok="$dok -> ${latest} UPDATE AVAILABLE"; updates=1
else
  dok="$dok (latest ${latest})"
fi

# (A weekly memory-mirror commit COUNT used to be reported here. Removed 2026-07-30: it measured
# nothing actionable — quiet nights are routine, so the number was noise in every report, and the
# real freshness observables are already covered: the timer-enabled assertion above and
# agentic-monitor's failed-unit sweeps. A per-agent "no commit in N days" check was also tried and
# removed the same day for alarming on a healthy fleet; if freshness is ever truly wanted, the
# observable is the timer's LastTriggerUSec, not a commit count.)

report="$(date -Is) | $os | $dok | fleet: ${FAILS} drift finding(s)"
# Put the actual finding text in the ping body, not just the count - so the Telegram message
# itself answers "what broke" without anyone needing to check the journal or the HC dashboard.
# Capped: a wall of findings would just get truncated by Telegram anyway, and the journal always
# has the full list.
if [ "$FAILS" -gt 0 ]; then
  report="${report} | DRIFT: ${DRIFT_LOG:0:1500}"
  [ "${#DRIFT_LOG}" -gt 1500 ] && report="${report}... (truncated, see journalctl -u agentic-divergence-check for the rest)"
fi
echo "$report"

suffix=""; { [ "$updates" = 1 ] || [ "$FAILS" -gt 0 ]; } && suffix="/fail"
# `|| true` on the delivery is deliberate and stays: a failed ping must not abort a run that has
# already done its work. But an undelivered report used to be indistinguishable from a delivered one,
# so the outcome is now stated on stdout, where the journal keeps it.
if curl -fsS -m 15 --data-raw "$report" "${UPDATE_HC_URL}${suffix}" -o /dev/null; then
  echo "$(date -Is) report delivered${suffix:+ (as failure)}"
else
  echo "$(date -Is) WARNING: report NOT delivered — healthchecks ping failed; the dead-man's switch will notice the missed beat" >&2
fi

echo
if [ "$FAILS" -eq 0 ] && [ "$updates" = 0 ]; then echo "$(date -Is) divergence-check: CLEAN"; exit 0
else echo "$(date -Is) divergence-check: $FAILS drift finding(s), updates=$updates"; exit 1; fi
