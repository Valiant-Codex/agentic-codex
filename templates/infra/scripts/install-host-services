#!/usr/bin/env bash
# install-host-services — install/refresh the HOST-level systemd services from this infra repo:
# kb-sync (git sync), agentic-monitor (health check + dead-man's-switch heartbeat), and
# agentic-update-check (weekly update report).
#
# This is the portable host bootstrap: on a fresh VPS, clone <ORG>/infra and run this, then
# `provision-agent <user> <brain>` per agent. Idempotent; run as the root-agent user (self-elevates).
# Per-agent topic units are handled by provision-agent, not here.
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
HERE="$(cd "$(dirname "$0")/.." && pwd)"   # infra repo root

echo "== install-host-services (from $HERE) =="

# kb-sync
install -m0755 "$HERE/scripts/kb-sync"                 /usr/local/bin/kb-sync
install -m0644 "$HERE/systemd/kb-sync.service"         /etc/systemd/system/kb-sync.service
install -m0644 "$HERE/systemd/kb-sync.timer"           /etc/systemd/system/kb-sync.timer
echo "  [ok] kb-sync"

# agentic-monitor
install -m0755 "$HERE/scripts/agentic-monitor"         /usr/local/bin/agentic-monitor
install -m0644 "$HERE/systemd/agentic-monitor.service" /etc/systemd/system/agentic-monitor.service
install -m0644 "$HERE/systemd/agentic-monitor.timer"   /etc/systemd/system/agentic-monitor.timer
if [ ! -f /etc/agentic-monitor.env ]; then
  install -m0600 "$HERE/systemd/agentic-monitor.env.example" /etc/agentic-monitor.env
  echo "  [WARN] created /etc/agentic-monitor.env from example — set HC_URL (secret) before it is useful."
else
  echo "  [ok] /etc/agentic-monitor.env already present (left as-is)"
fi
echo "  [ok] agentic-monitor"

# agentic-update-check (weekly update-availability report)
install -m0755 "$HERE/scripts/agentic-update-check"          /usr/local/bin/agentic-update-check
install -m0644 "$HERE/systemd/agentic-update-check.service"  /etc/systemd/system/agentic-update-check.service
install -m0644 "$HERE/systemd/agentic-update-check.timer"    /etc/systemd/system/agentic-update-check.timer
echo "  [ok] agentic-update-check"

# fleet roster — single source of truth for kb-sync / agentic-monitor / agentic-divergence-check
install -D -m0644 "$HERE/fleet-agents" /usr/local/share/agentic/fleet-agents
echo "  [ok] fleet roster (/usr/local/share/agentic/fleet-agents)"

# agentic-divergence-check (daily structural linter) — installed; enable once your fleet passes it
install -m0755 "$HERE/scripts/agentic-divergence-check"          /usr/local/bin/agentic-divergence-check
install -m0644 "$HERE/systemd/agentic-divergence-check.service"  /etc/systemd/system/agentic-divergence-check.service
install -m0644 "$HERE/systemd/agentic-divergence-check.timer"    /etc/systemd/system/agentic-divergence-check.timer
echo "  [ok] agentic-divergence-check (run it once by hand, then: systemctl enable --now agentic-divergence-check.timer)"

# memory-mirror (optional nightly: runtime auto-memory -> git) — installed, timer DISABLED by default
install -m0755 "$HERE/scripts/memory-mirror"          /usr/local/bin/memory-mirror
install -m0644 "$HERE/systemd/memory-mirror@.service" /etc/systemd/system/memory-mirror@.service
install -m0644 "$HERE/systemd/memory-mirror@.timer"   /etc/systemd/system/memory-mirror@.timer
echo "  [ok] memory-mirror (optional; enable per agent: systemctl enable --now memory-mirror@<user>.timer)"

# Manifest of what this installer put where, so a checker can prove the installed artifacts still
# match the repo. Generated — never hand-maintained — so it cannot itself drift.
{ for pair in \
    "scripts/kb-sync:/usr/local/bin/kb-sync" \
    "scripts/agentic-monitor:/usr/local/bin/agentic-monitor" \
    "scripts/agentic-update-check:/usr/local/bin/agentic-update-check" \
    "scripts/agentic-divergence-check:/usr/local/bin/agentic-divergence-check" \
    "scripts/memory-mirror:/usr/local/bin/memory-mirror" \
    "bin/claude-topic:/usr/local/bin/claude-topic" \
    "fleet-agents:/usr/local/share/agentic/fleet-agents" \
    "systemd/kb-sync.service:/etc/systemd/system/kb-sync.service" \
    "systemd/kb-sync.timer:/etc/systemd/system/kb-sync.timer" \
    "systemd/agentic-monitor.service:/etc/systemd/system/agentic-monitor.service" \
    "systemd/agentic-monitor.timer:/etc/systemd/system/agentic-monitor.timer" \
    "systemd/agentic-update-check.service:/etc/systemd/system/agentic-update-check.service" \
    "systemd/agentic-update-check.timer:/etc/systemd/system/agentic-update-check.timer" \
    "systemd/agentic-divergence-check.service:/etc/systemd/system/agentic-divergence-check.service" \
    "systemd/agentic-divergence-check.timer:/etc/systemd/system/agentic-divergence-check.timer" \
    "systemd/memory-mirror@.service:/etc/systemd/system/memory-mirror@.service" \
    "systemd/memory-mirror@.timer:/etc/systemd/system/memory-mirror@.timer" ; do
    src="${pair%%:*}"; dst="${pair#*:}"
    [ -f "$HERE/$src" ] && echo "$dst|$HERE/$src"
  done; } > /usr/local/share/agentic/installed.manifest
chmod 0644 /usr/local/share/agentic/installed.manifest
echo "  [ok] installed manifest"

systemctl daemon-reload
systemctl enable --now kb-sync.timer agentic-monitor.timer agentic-update-check.timer >/dev/null 2>&1 || true
echo "  [ok] timers enabled"
systemctl list-timers kb-sync.timer agentic-monitor.timer agentic-update-check.timer --no-pager 2>/dev/null | grep -E "kb-sync|agentic-monitor|agentic-update" || true
echo "== done =="
