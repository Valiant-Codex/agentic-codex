#!/usr/bin/env bash
# claude-topic — manage this agent's Claude Code Remote Control topic sessions.
#
# Topics are supervised by systemd USER services (claude-topic@<key>), which run
# `claude --remote-control` in a pty (via the unit). This is the single, robust,
# reboot/crash-surviving model — no tmux. The wrapper is the control surface;
# it is root-owned at /usr/local/bin/claude-topic (canonical source:
# <ORG>/infra bin/claude-topic) and discovers the calling agent's own repo
# for its topic registry. The command is named after the unit it drives.
# (the bare `topic` compatibility symlink was removed on 2026-07-30).
#
# Error-handling contract (the failure modes this guards against):
#   - an unknown/typo'd key must never reach systemctl: `claude-topic@<typo>` is a
#     valid template instance, so it WOULD start, fail in `run`, and fail-loop
#     against Restart=always until StartLimitBurst. Keys are validated first.
#   - a restart must never silently start a NEW conversation: that orphans history
#     (incident 2026-07-17, topic `ideas`). If no sessionId is stored we capture the
#     live one first, and refuse rather than guess when there is nothing to resume.
#   - `stop` records the live sessionId before killing the process, so the topic can
#     be resumed later instead of coming back blank.
#   - topics.tsv and topics.state are agent-writable — a prompt injection could plant
#     bytes in either. A stored sessionId must look like a UUID and a display name
#     must not start with '-' before either reaches a `claude` command line, because
#     `--remote-control`/`--resume` take an optional/positional value and a leading
#     '-' gets parsed by claude as a DIFFERENT FLAG, not as that value — this is how a
#     one-shot injection would otherwise turn into a persistent, unattended reconfig
#     of the agent on every restart/reboot.
#   - topics.state / topics.tsv writes are lock-serialized with a private mktemp, and
#     a failed read of the existing file aborts instead of silently writing a file
#     that only contains the new row (data loss on the file that matters most).
#   - every command reports what actually happened, and exits nonzero when it didn't.
set -euo pipefail

PROG="${0##*/}"
HOME_DIR="${HOME:-}"
SESS_DIR="${HOME_DIR}/.claude/sessions"
PROJ_DIR="${HOME_DIR}/.claude/projects"   # per-cwd conversation transcripts (<sessionId>.jsonl)
# systemd --user needs these; default them if the caller's env lacks them.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

err() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { err "$*"; exit 1; }

[ -n "$HOME_DIR" ] || die "HOME is not set"

# This agent's own repo: kb-agent-<role>-<this Unix username>, pinned to $(id -un)
# rather than a bare kb-agent-*-* glob — kb-agent-shared/kb-agent-template can
# never match this (neither ends in the username), so no separate exclusion is
# needed. (The old `grep -vE 'kb-agent-shared|kb-agent-template'` was actually dead
# code: those two names are single-token after the prefix and never matched
# `kb-agent-*-*` to begin with — see scripts/kb-sync's own comment on this. Its
# unanchored substring form was also a bypass in its own right: renaming the real
# repo to include "kb-agent-shared" as a substring hid it from the exclusion
# entirely.) Even pinned to this user, more than one candidate can still exist
# (e.g. a planted `kb-agent-evil-<user>` alongside the real one, from a prompt
# injection with write access to this agent's own home) — refuse rather than guess
# which is real, since the loser's registry/display-name would otherwise silently
# feed into `claude`.
# NOTE: scripts/agentic-monitor keeps an independent copy of this same resolution —
# keep both in sync. It additionally alarms on 0 candidates and "repo resolved but
# no topics.tsv", which this script does not need to duplicate: those already
# surface here via the existing `require_registry`/`require_known_key` messages on
# the commands that need a registry (see there for why the monitor's silence on
# those same cases was itself a bug).
_agent_repo_candidates="$(ls -d "$HOME_DIR"/github/*/kb-agent-*-"$(id -un)"/ 2>/dev/null || true)"
_agent_repo_count="$(printf '%s' "$_agent_repo_candidates" | grep -c . || true)"
if [ "${_agent_repo_count:-0}" -gt 1 ]; then
  die "multiple candidate agent repos under $HOME_DIR/github/ matching kb-agent-*-$(id -un) — refusing to guess which is real:
$(printf '%s' "$_agent_repo_candidates" | sed 's/^/  /')
  Remove or rename whichever is not the real brain repo, then retry."
fi
AGENT_REPO="$_agent_repo_candidates"
AGENT_REPO="${AGENT_REPO%/}"
REG="${AGENT_REPO}/deploy/topics.tsv"          # versioned: key<TAB>Display Name
STATE_DIR="${HOME_DIR}/.config/agent"
STATE="${STATE_DIR}/topics.state"              # runtime: key<TAB>sessionId
ROTATED="${STATE_DIR}/topics.rotated"          # append-only: when<TAB>key<TAB>abandoned sessionId<TAB>name

svc()       { echo "claude-topic@${1}.service"; }
# awk (exact field match), not grep -P: keys may contain '.', a regex metachar.
reg_name()  { [ -f "$REG" ]   && awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$REG"   || true; }
state_sid() { [ -f "$STATE" ] && awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$STATE" || true; }
reg_has()   { [ -f "$REG" ]   && awk -F'\t' -v k="$1" '$1==k{f=1} END{exit !f}' "$REG"; }

# Where to place the lock guarding <file>: under $XDG_RUNTIME_DIR — never beside
# <file> itself, because for topics.tsv that directory is git-versioned, and a lock
# file left there is untracked cruft that `git add -A` / kb-sync would happily pick up.
lock_path_for() {  # lock_path_for <file>
  local abs
  abs="$(cd "$(dirname -- "$1")" 2>/dev/null && pwd -P)/$(basename -- "$1")" || abs="$1"
  printf '%s/claude-topic-lock-%s\n' "${XDG_RUNTIME_DIR}" "$(printf '%s' "$abs" | tr '/' '_')"
}
# Atomically upsert/delete a key in a TAB-separated <file> (topics.tsv / topics.state).
# flock-serialized (lock path above) with a private mktemp NEXT TO <file> (same
# filesystem, so the final `mv` is atomic), so two concurrent invocations (e.g. a
# restart of one topic racing a `new`/`remember` of another, same Unix user) never
# share a tmp filename — a fixed name let one invocation's mv steal the tmp file out
# from under another mid-write. Both the `exec` that opens the lock fd and the
# `flock` itself are followed by an explicit `|| exit 1`: this whole block runs
# inside a `()` subshell that is the left side of `||`, which disables `errexit` for
# its entire body — confirmed empirically that a failed `exec` here does NOT abort
# on its own, it just leaves fd 200 unusable and execution carries on unlocked. A
# failed read of an existing <file> also aborts (via the same exit 1 -> die) instead
# of silently writing a file containing only the one row being upserted — the
# original bug in `save_sid`. `chmod --reference` preserves the file's existing
# permissions across the mktemp+mv, since mktemp defaults to 0600 and both
# topics.tsv and topics.state are normally 0664.
tsv_upsert() {  # tsv_upsert <file> <key> <value>
  local file="$1" key="$2" val="$3"
  mkdir -p "$(dirname "$file")"
  (
    exec 200>"$(lock_path_for "$file")" || exit 1
    flock 200 || exit 1
    local tmp rest=""
    if [ -f "$file" ]; then
      rest="$(awk -F'\t' -v k="$key" '$1!=k' "$file")" || { echo "cannot read $file" >&2; exit 1; }
    fi
    tmp="$(mktemp "${file}.XXXXXX")" || exit 1
    trap 'rm -f "$tmp"' EXIT     # never leave a stray tmp beside a git-tracked file
    trap 'rm -f "$tmp"' EXIT     # never leave a stray tmp beside a git-tracked file
    trap 'rm -f "$tmp"' EXIT     # never leave a stray tmp beside a git-tracked file
    [ -f "$file" ] && chmod --reference="$file" "$tmp" 2>/dev/null
    { [ -n "$rest" ] && printf '%s\n' "$rest"; printf '%s\t%s\n' "$key" "$val"; } > "$tmp" && mv "$tmp" "$file"
  ) || die "failed to update $file"
}
tsv_delete() {  # tsv_delete <file> <key> — no-op if <file> doesn't exist
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  (
    exec 200>"$(lock_path_for "$file")" || exit 1
    flock 200 || exit 1
    local tmp rest
    rest="$(awk -F'\t' -v k="$key" '$1!=k' "$file")" || { echo "cannot read $file" >&2; exit 1; }
    tmp="$(mktemp "${file}.XXXXXX")" || exit 1
    chmod --reference="$file" "$tmp" 2>/dev/null
    # NOTE: this must be `[ -z "$rest" ] || printf ...`, NOT `[ -n "$rest" ] && printf ...`.
    # The `&&` form makes the whole { } group's exit status 1 when $rest is empty (deleting
    # the last/only row), so `mv` never ran, `tsv_delete` reported failure on a no-op-shaped
    # case, and `cmd_remove`/`cmd_restart --new` broke on exactly that ordinary state.
    { [ -z "$rest" ] || printf '%s\n' "$rest"; } > "$tmp" && mv "$tmp" "$file"
  ) || die "failed to update $file"
}
# Append-if-absent (registration semantics: a no-op if the key is already there).
# Uses the same lock+mktemp skeleton as tsv_upsert/tsv_delete (not a raw `>>`), so a
# lock/mktemp failure aborts here too instead of silently appending unlocked — a
# plain `>>` needs no directory-write-independent permission and would otherwise go
# through even with the lock unacquired. The existing content is rewritten with a
# normalized trailing newline before the new row is added, instead of a raw append
# concatenating onto a row that was missing one.
tsv_append_if_absent() {  # tsv_append_if_absent <file> <key> <value>
  local file="$1" key="$2" val="$3"
  mkdir -p "$(dirname "$file")"
  (
    exec 200>"$(lock_path_for "$file")" || exit 1
    flock 200 || exit 1
    local tmp rest=""
    if [ -f "$file" ]; then
      awk -F'\t' -v k="$key" '$1==k{f=1} END{exit !f}' "$file" && exit 0
      rest="$(cat "$file")" || { echo "cannot read $file" >&2; exit 1; }
    fi
    tmp="$(mktemp "${file}.XXXXXX")" || exit 1
    [ -f "$file" ] && chmod --reference="$file" "$tmp" 2>/dev/null
    { [ -z "$rest" ] || printf '%s\n' "$rest"; printf '%s\t%s\n' "$key" "$val"; } > "$tmp" && mv "$tmp" "$file"
  ) || die "failed to update $file"
}
save_sid()  { tsv_upsert "$STATE" "$1" "$2"; }
del_sid()   { tsv_delete "$STATE" "$1"; }
reg_del()   { tsv_delete "$REG" "$1"; }
reg_add()   { tsv_append_if_absent "$REG" "$1" "$2"; }

# The registry is a GIT-TRACKED file (deploy/topics.tsv): the portable, versioned declaration
# of which topics exist, which `provision-agent` reads to recreate them on a rebuilt box. So a
# mutation written only to the working tree is NOT durable — it holds until the next reprovision
# and then silently reverts to whatever HEAD says. (It also stalls this repo's kb-sync
# `pull --ff-only` the moment the remote touches the same file; unrelated dirt does not, but a
# collision on topics.tsv itself does.) Commit and push the one file we changed, mirroring
# scripts/memory-mirror.
#
# PATH-SCOPED on purpose: `git commit -- <path>` commits the working-tree version of that single
# file and leaves everything else alone — including an agent's staged, half-finished work
# elsewhere in its own brain. Never `git add -A` here.
#
# NEVER FATAL: by the time this runs the systemd side already succeeded, so a git failure must
# warn loudly rather than unwind a live topic. The daily agentic-divergence-check is the backstop
# for a commit that did not get pushed.
reg_commit() {  # reg_commit <verb> <key>
  local verb="$1" key="$2" repo="${AGENT_REPO:-}"
  if [ -z "$repo" ] || ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    err "warning: no git repo at '${repo:-<unset>}' — ${REG##*/} change is local only"
    return 0
  fi
  # A brand-new registry is untracked, and `git commit -- <path>` refuses an unknown pathspec.
  # The `add` must be checked: on failure (a .gitignore match, a held index.lock, permissions) the
  # `diff --quiet HEAD -- <untracked path>` below returns 0 — "no change" — so an unchecked add
  # turns the one case this branch exists for into a completely silent local-only mutation.
  if ! git -C "$repo" ls-files --error-unmatch -- "$REG" >/dev/null 2>&1; then
    if ! git -C "$repo" add -- "$REG" >/dev/null 2>&1; then
      err "warning: ${REG##*/} is untracked and could not be staged (gitignored? index locked?) — change is local only"
      return 0
    fi
  fi
  if git -C "$repo" diff --quiet HEAD -- "$REG" 2>/dev/null; then
    return 0                                   # nothing actually changed
  fi
  # Whether it is safe to push is decided BEFORE we add a commit of our own. `git push` publishes
  # the whole branch, not our one path-scoped commit: if the agent already had unpushed commits,
  # pushing here would publish that unrelated, possibly half-finished work — and would silently
  # clear the `ahead > 0` condition agentic-divergence-check exists to report. So when the repo is
  # already ahead we commit and stop, leaving the pre-existing divergence visible to the daily
  # check instead of resolving it on the agent's behalf.
  local pre_ahead=0
  if git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    pre_ahead="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  else
    pre_ahead=unknown                          # no upstream: never guess, never push
  fi
  if ! git -C "$repo" commit -q -m "[topic] $verb $key" -- "$REG" 2>/dev/null; then
    err "warning: could not commit ${REG##*/} — change is local only; commit it by hand"
    return 0
  fi
  if [ "$pre_ahead" = unknown ]; then
    err "warning: ${REG##*/} committed but the branch has no upstream — not pushing; set one and push by hand"
    return 0
  fi
  if [ "$pre_ahead" -gt 0 ]; then
    err "warning: ${REG##*/} committed but NOT pushed — this repo already had $pre_ahead unpushed commit(s) and pushing would publish them too; review and push by hand"
    return 0
  fi
  if ! git -C "$repo" push -q 2>/dev/null; then
    err "warning: ${REG##*/} committed but push failed — repo is ahead of origin; push it by hand"
  fi
  return 0
}

# `claude --resume <id>` hard-fails ("No conversation found with session ID") when the
# transcript was never written — e.g. a session killed seconds after creation. Under
# Restart=always that fail-loops the unit into 'failed' via StartLimitBurst, so check first.
transcript_exists() {
  local sid="$1" f
  [ -n "$sid" ] && [ -d "$PROJ_DIR" ] || return 1
  for f in "$PROJ_DIR"/*/"$sid".jsonl; do [ -e "$f" ] && return 0; done
  return 1
}

usage() {
  # $PROG, not a hardcoded name: this is reachable as `claude-topic` or as the
  # any future alias, and the help should match how it was invoked.
  cat <<EOF
Usage (systemd-managed topics — no tmux):
  $PROG list                        list topics: key, state, sessionId, display name
  $PROG urls                        list every topic's Remote Control URL (test them by hand)
  $PROG rotate <key>                abandon the conversation and start fresh, so the topic
                                           gets a NEW bridge id — the fix when a topic is
                                           active but the app says "session can't be
                                           found". The abandoned sessionId is appended to
                                           topics.rotated first, so it stays addressable.
  $PROG rotate-all [--dry-run]      rotate EVERY enabled topic — what the boot unit runs, so
                                           reachability after a reboot never depends on a
                                           check that cannot see the failure. Writes a
                                           digest of what was abandoned + the new URLs.
  $PROG new <key> "<Display Name>"  register + start a new topic under systemd
  $PROG restart <key>               systemctl restart (resumes the same sessionId)
  $PROG stop <key>                  stop + disable the topic's service (survives as state)
  $PROG remove <key>                unregister the topic for good (registry + state + unit)
  $PROG status <key> [--porcelain]  service state + stored/live/derived sessionId.
                                    --porcelain prints tab-separated field<TAB>value lines
                                    for machines, including a computed 'drift' verdict
                                    (yes/no/unknown/unanchored). Never parse the prose.
  $PROG remember <key>              record the running topic's live sessionId to state
  $PROG run <key>                   foreground launch (invoked by the systemd unit)

Flags:
  restart --new <key>               allow starting a FRESH conversation when no
                                    sessionId is stored (default: refuse, to protect
                                    history — see the 2026-07-17 incident)
EOF
}

# --- preflight ---------------------------------------------------------------
require_systemd() {
  systemctl --user show-environment >/dev/null 2>&1 || die \
    "cannot reach the systemd user manager for '$(id -un)' (XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR).
  If this user has no login session, lingering must be enabled:  sudo loginctl enable-linger $(id -un)"
}
require_registry() {
  [ -n "$AGENT_REPO" ] || die "no agent repo found under $HOME_DIR/github/<org> (expected kb-agent-<role>-<name>/)"
  [ -f "$REG" ] || die "topic registry not found: $REG"
}
# systemd instance names and the TSV registry both constrain what a key may contain.
require_valid_key() {
  case "$1" in
    '' ) die "empty topic key" ;;
    *[!A-Za-z0-9._-]* ) die "invalid topic key '$1' — allowed: letters, digits, '.', '_', '-'" ;;
  esac
}
# `--remote-control [name]` / `--resume [id]` take an OPTIONAL value: claude's own
# parser reads a token starting with '-' as a flag, not as that value. topics.tsv
# (display name) and topics.state (sessionId) are agent-writable, so a value with a
# leading '-' — planted directly or via a compromised `new`/`remember` — would be
# silently re-parsed as an arbitrary claude flag on the next unattended `run`.
require_safe_value() {  # require_safe_value <label> <value>
  case "$2" in
    -*) die "$1 '$2' begins with '-' — refusing (would be parsed by claude as a flag, not as its value)" ;;
  esac
}
require_uuid() {  # require_uuid <label> <value>
  [[ "$2" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
    || die "$1 '$2' is not a UUID — refusing to pass it to claude --resume"
}

# --- introspection -----------------------------------------------------------
# The claude process pid for a running topic = the child of the service MainPID (script).
claude_pid_for() {
  local mp; mp="$(systemctl --user show -p MainPID --value "$(svc "$1")" 2>/dev/null || true)"
  [ -n "${mp:-}" ] && [ "$mp" != 0 ] || return 0
  pgrep -P "$mp" -f 'claude' 2>/dev/null | head -1 || true
}
# Live sessionId from the running claude's session file.
session_id_live() {
  local cp f; cp="$(claude_pid_for "$1")"; [ -n "$cp" ] || return 0
  f="${SESS_DIR}/${cp}.json"
  [ -f "$f" ] && python3 -c "import json;print(json.load(open('$f')).get('sessionId',''))" 2>/dev/null || true
}
# Newest sessionId on a given Remote Control bridge, derived from transcripts on disk.
#
# WHY THIS EXISTS. The runtime — not this wrapper — mints sessionIds, and it re-keys them
# silently on /clear and on compaction. topics.state is only written by new/restart/remember,
# so from the moment the runtime forks, the stored pointer is stale and nothing says so. On
# 2026-08-30 that cost three days of conversation; reconstructing the lineage afterwards showed
# it was the FOURTH such split on this topic, and one on 2026-08-25 had silently orphaned two
# days and 4.6 MB. Neither was visible from inside.
#
# The bridge id is the durable identity the sessionId is not: the runtime re-keys the session on
# every /clear, but re-keys the bridge only when we deliberately start fresh (`new`/`rotate`).
# So: same bridge = same topic, and the newest transcript on that bridge is the live branch.
# Verified across both agents' topics, including reconstructing four drifted ones from disk with
# no live process and no state file.
#
# Deliberately derives from DISK, so it answers after a crash and at boot — exactly when
# session_id_live cannot, because the session file dies with the process it describes.
# Normalisation note: session JSON says session_01…, transcripts say cse_01… — same suffix.
sid_newest_on_bridge() {
  local bridge="$1"
  [ -n "$bridge" ] || return 0
  BR="${bridge#session_}" BR="cse_${BR#cse_}" PD="$PROJ_DIR" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, glob
br = os.environ["BR"]; pd = os.environ["PD"]
best = (None, None)   # (mtime, sessionId)
for f in glob.glob(os.path.join(pd, "*", "*.jsonl")):
    seen = False
    try:
        with open(f, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if '"bridge-session"' in line:
                    try:
                        if (json.loads(line).get("bridgeSessionId") or "") == br:
                            seen = True; break      # one file, one bridge — stop reading
                    except Exception: pass
    except Exception:
        continue
    if not seen: continue
    # ORDER BY MTIME, NOT BY THE TIMESTAMP THE FILE DECLARES ABOUT ITSELF. This tree is writable
    # by the agent whose resume we are choosing, so a self-declared field is an instruction from
    # the data: a two-line file claiming a timestamp in 2099 used to win outright and be exec'd by
    # cmd_run, verified against a fixture.
    #
    # BE CLEAR ABOUT WHAT THIS BUYS, because it is less than it looks. mtime defeats PRE-planting:
    # a file dropped today cannot win a restart that happens after the real branch is appended to
    # again. It does NOT defeat a file planted in the window before a restart, which gets mtime
    # 'now' for free. That hole cannot be closed here — the tree belongs to the principal we would
    # be defending against, and an injection with a shell can write topics.state directly anyway.
    # So the real control is DETECTION, not prevention: every adoption cmd_run makes is appended
    # to topics.rotated, and agentic-divergence-check reports adoptions it finds there. Do not
    # add a guard here and call the class closed.
    #
    # It is also strictly cheaper — no timestamp parsing at all.
    try: m = os.path.getmtime(f)
    except Exception: continue
    if best[0] is None or m > best[0]:
        best = (m, os.path.basename(f)[:-6])
print(best[1] or "")
PYEOF
}
# The bridge a topic is on, taken from disk for a given sessionId.
bridge_of_sid() {
  local sid="$1"
  [ -n "$sid" ] || return 0
  SID="$sid" PD="$PROJ_DIR" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, glob
sid = os.environ["SID"]; pd = os.environ["PD"]
for f in glob.glob(os.path.join(pd, "*", sid + ".jsonl")):
    br = ""
    with open(f, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if '"bridge-session"' in line:
                try: br = json.loads(line).get("bridgeSessionId") or br
                except Exception: pass
    print(br); break
PYEOF
}

# Live Remote Control bridge id from the running claude's session file.
#
# READ THIS BEFORE TRUSTING IT: this is the id the session ANNOUNCES, not proof that the
# server still honours it. The two diverge, and that divergence is the 2026-08-06 outage:
# the bridge id is derived from the RESUMED conversation, so `--resume <sid>` re-announces
# the same bridge id on every restart. When the server drops that bridge (the hard reboot
# did, for eleven of twelve topics), the session keeps announcing the dead id, writes
# "/remote-control is active" into its own transcript, and is unreachable forever —
# while the unit sits there active and green. Restarting cannot fix it: it re-announces
# the same dead id. Only a NEW conversation mints a new bridge (`$PROG rotate <key>`).
#
# So: use this to PRINT a URL for a human to test. Never use it as a health signal.
# Reachability is not observable from this host — do not write a check that pretends it is.
bridge_id_live() {
  local cp f; cp="$(claude_pid_for "$1")"; [ -n "$cp" ] || return 0
  f="${SESS_DIR}/${cp}.json"
  [ -f "$f" ] && python3 -c "import json;print(json.load(open('$f')).get('bridgeSessionId') or '')" 2>/dev/null || true
}
# Same beat-after-exec race as wait_session_id, and worse here: the bridge id lands after
# the sessionId, so a rotate that printed immediately reported '<no bridge>' on a perfectly
# good start — the one output guaranteed to look like the failure it just repaired.
wait_bridge_id() {
  local key="$1" i b
  for i in $(seq 1 40); do b="$(bridge_id_live "$key")"; [ -n "$b" ] && { echo "$b"; return 0; }; sleep 0.5; done
  return 0
}
# Poll for the sessionId of a just-(re)started topic — the session file is written a
# beat after exec, so reading it immediately reports empty on a perfectly good start.
wait_session_id() {
  local key="$1" i sid
  for i in $(seq 1 30); do sid="$(session_id_live "$key")"; [ -n "$sid" ] && { echo "$sid"; return 0; }; sleep 0.5; done
  return 0
}
svc_state() { systemctl --user is-active "$(svc "$1")" 2>/dev/null || true; }
list_keys() {
  systemctl --user list-units 'claude-topic@*' --all --no-legend --plain 2>/dev/null \
    | awk '{print $1}' | sed -n 's/^claude-topic@\(.*\)\.service$/\1/p' | sort -u
}
# Same charset as require_valid_key: a registry row with a bogus key (e.g. from a
# corrupted/tampered topics.tsv) must not reach `for k in $(...)` unquoted, where a
# key like '*' glob-expands against the unit's WorkingDirectory (the agent's home)
# and a key with a space word-splits. Invalid rows are skipped, not silently used.
reg_keys() {
  [ -f "$REG" ] && awk -F'\t' -v prog="$PROG" '
    NF && $1 !~ /^#/ {
      if ($1 ~ /^[A-Za-z0-9._-]+$/) print $1
      else print prog ": warning: ignoring invalid key \"" $1 "\" in topics.tsv (line " NR ")" > "/dev/stderr"
    }' "$REG" || true
}
all_keys() { { reg_keys; list_keys; } | sort -u; }
# No `| grep -q`: SIGPIPE + pipefail would make a match look like a failure.
unit_known() { local k; for k in $(list_keys); do [ "$k" = "$1" ] && return 0; done; return 1; }
known_key()  { reg_has "$1" || unit_known "$1"; }
require_known_key() {
  known_key "$1" && return 0
  die "unknown topic '$1' — not in $REG and no claude-topic@$1 service on this box.
  Known topics: $(all_keys | paste -sd' ' - || true)"
}

# --- commands ----------------------------------------------------------------
cmd_list() {
  require_systemd
  printf '%-18s %-12s %-38s %s\n' KEY STATE SESSION_ID DISPLAY
  local k st
  for k in $(all_keys); do
    if unit_known "$k"; then st="$(svc_state "$k")"; [ -n "$st" ] || st=unknown
    else st="not-started"; fi
    printf '%-18s %-12s %-38s %s\n' "$k" "$st" "$(state_sid "$k")" "$(reg_name "$k")"
  done
}

# --- status ------------------------------------------------------------------
# `--porcelain` exists because the daily divergence check used to recover the live sessionId by
# running `sed -n 's/.*(live: \(...\)).*/\1/p'` over the PROSE below. That regex returns empty —
# and the check then `continue`s, reporting nothing — for a stopped topic, for empty output
# (command missing, sudo failed, user manager unreachable), for any rewording of this line, and
# for a change of case. A guardian whose only input is another program's prose fails open on every
# one of those, silently. Verified against all four.
#
# So the drift verdict is computed HERE, by the code that owns the state, and published as a
# field. Three values, and the third is the point: `unknown` is not `no`. A caller that cannot
# tell must be able to say so instead of staying quiet.
#
# It also publishes `newest_on_bridge`, which is what makes an ALREADY-COMPLETED split visible.
# stored-vs-live only ever sees a split still in progress: on 2026-08-30 both `durin` and
# galadriel's `ideas` reported CLEAN with orphaned branches sitting on disk, because by then the
# damage was done and the live session agreed with the pointer that had caused it.
cmd_status_porcelain() {
  local k="$1" stored live newest bridge act ena drift
  stored="$(state_sid "$k")"
  live="$(session_id_live "$k")"
  bridge="$(bridge_id_live "$k")"
  [ -n "$bridge" ] || bridge="$(bridge_of_sid "$stored")"
  newest="$(sid_newest_on_bridge "$bridge")"
  act="$(svc_state "$k")"; [ -n "$act" ] || act=unknown
  ena="$(systemctl --user is-enabled "$(svc "$k")" 2>/dev/null || echo unknown)"
  if [ -z "$stored" ]; then
    drift=unanchored                      # enabled with no pointer at all: a restart starts blank
  elif [ -n "$live" ] && [ "$live" != "$stored" ]; then
    drift=yes
  elif [ -n "$newest" ] && [ "$newest" != "$stored" ]; then
    drift=yes                             # the completed-split case the old check could not see
  elif [ -n "$live" ] || [ -n "$newest" ]; then
    drift=no
  else
    drift=unknown                         # nothing running AND nothing derivable — say so
  fi
  printf 'key\t%s\n'              "$k"
  printf 'display\t%s\n'          "$(reg_name "$k")"
  printf 'active\t%s\n'           "$act"
  printf 'enabled\t%s\n'          "$ena"
  printf 'stored\t%s\n'           "$stored"
  printf 'live\t%s\n'             "$live"
  printf 'newest_on_bridge\t%s\n' "$newest"
  printf 'bridge\t%s\n'           "$bridge"
  printf 'registered\t%s\n'       "$(reg_has "$k" && echo yes || echo no)"
  printf 'drift\t%s\n'            "$drift"
}

cmd_status() {
  local k="" porcelain=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --porcelain) porcelain=1 ;;
      -*) die "unknown flag '$1' for status" ;;
      *)  [ -z "$k" ] || die "status takes one key (got '$k' and '$1')"; k="$1" ;;
    esac
    shift
  done
  [ -n "$k" ] || { usage; exit 2; }
  local stored live
  require_valid_key "$k"; require_systemd; require_known_key "$k"
  if [ "$porcelain" = 1 ]; then cmd_status_porcelain "$k"; return 0; fi
  stored="$(state_sid "$k")"; live="$(session_id_live "$k")"
  echo "key:        $k"
  echo "display:    $(reg_name "$k")"
  echo "state:      $(svc_state "$k") / enabled=$(systemctl --user is-enabled "$(svc "$k")" 2>/dev/null || true)"
  echo "sessionId:  ${stored:-<none stored>}  (live: ${live:-<not running>})"
  [ -z "$stored" ] || [ -z "$live" ] || [ "$stored" = "$live" ] || \
    err "warning: live sessionId differs from stored — '$PROG remember $k' to reconcile"
  # Also show the branch derived from disk. Without it, `status` on a topic that is not running
  # says nothing at all about drift — and a completed split looks identical to a healthy topic.
  local _nb; _nb="$(sid_newest_on_bridge "$(bridge_id_live "$k")")"
  [ -n "$_nb" ] || _nb="$(sid_newest_on_bridge "$(bridge_of_sid "$stored")")"
  echo "on bridge:  ${_nb:-<cannot derive from disk>}"
  [ -z "$_nb" ] || [ "$_nb" = "$stored" ] || \
    err "warning: the newest conversation on this topic's bridge is $_nb, not the stored $stored —
  a restart will adopt $_nb. If that is not what you want, '$PROG status $k --porcelain' and read 'drift'."
  reg_has "$k" || err "warning: '$k' has a service but no entry in $REG — it cannot be restarted until registered"
  local b bu; b="$(bridge_id_live "$k")"
  bu="<none — not on Remote Control>"; [ -z "$b" ] || bu="https://claude.ai/code/$b"
  echo "bridge:     $bu"
  [ -z "$b" ] || echo "            (open it to test: active+enabled does NOT mean reachable — see bridge_id_live)"
  systemctl --user show -p MainPID -p NRestarts -p ActiveEnterTimestamp "$(svc "$k")" 2>/dev/null | sed 's/^/  /'
}

# Print every topic's Remote Control URL. Exists because recovering from a dead bridge
# used to mean hand-parsing ~/.claude/sessions/*.json against /proc — an afternoon of
# archaeology on 2026-08-06. The URLs are the ONLY way to tell a live topic from a
# green-but-unreachable one, and only a human clicking them can do that.
cmd_urls() {
  require_systemd
  printf '%-18s %-12s %s\n' KEY STATE URL
  local k st b bu
  for k in $(all_keys); do
    if unit_known "$k"; then st="$(svc_state "$k")"; [ -n "$st" ] || st=unknown
    else st="not-started"; fi
    b="$(bridge_id_live "$k")"
    bu="<no bridge>"; [ -z "$b" ] || bu="https://claude.ai/code/$b"
    printf '%-18s %-12s %s\n' "$k" "$st" "$bu"
  done
  err "note: a URL here proves the session ANNOUNCED that bridge, not that the server still serves it.
  If one answers 'session can't be found', that topic needs '$PROG rotate <key>'."
}

# Abandon a topic's conversation and start a fresh one, so it gets a NEW bridge id.
#
# The recovery verb for the 2026-08-06 failure mode. `restart` deliberately cannot do this
# (it resumes, hence re-announces the same dead bridge), and `restart --new` discards the
# stored sessionId with only a stderr warning — fine when a human is watching, not fine as
# the documented recovery path for a whole fleet. `rotate` appends the abandoned id to
# $ROTATED first, so every replaced conversation stays addressable afterwards.
# The sessionId `rotate` would actually abandon, resolved the same way whether we are about to
# destroy it or merely previewing. This exists because the two disagreed: the dry-run printed the
# STORED pointer while the action abandoned the LIVE one, so on a drifted topic — the only reason
# anyone runs the preview — the preview named the wrong conversation. Live wins; disk-derived is
# the fallback for a topic that is not running; stored is the last resort.
sid_to_abandon() {  # sid_to_abandon <key>
  local key="$1" s
  s="$(session_id_live "$key")"
  [ -n "$s" ] || s="$(sid_newest_on_bridge "$(bridge_of_sid "$(state_sid "$key")")")"
  [ -n "$s" ] || s="$(state_sid "$key")"
  printf '%s' "$s"
}

cmd_rotate() {
  local key="$1" old
  require_valid_key "$key"; require_systemd; require_registry; require_known_key "$key"
  # Record the id actually being abandoned. This preferred the STORED pointer, so on a drifted
  # topic it wrote the wrong id into topics.rotated and the conversation being destroyed was
  # recorded nowhere — the opposite of what the note below promises. Live wins; disk-derived is
  # the fallback for a topic that is not running.
  old="$(sid_to_abandon "$key")"
  if [ -n "$old" ]; then
    umask 077
    printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "$key" "$old" "$(reg_name "$key")" >> "$ROTATED" \
      || die "could not append to $ROTATED — refusing to discard $old with no record of it"
    err "note: recorded abandoned sessionId $old for '$key' in $ROTATED
  Its transcript stays on disk; put the id back in $STATE and '$PROG restart $key' to read it again."
  else
    err "note: '$key' had no sessionId to abandon — this is a plain fresh start"
  fi
  cmd_restart --new "$key"
  local b; b="$(wait_bridge_id "$key")"
  if [ -n "$b" ]; then
    echo "new Remote Control URL: https://claude.ai/code/$b"
    echo "open it — that is the only way to confirm the rotate actually took."
  else
    err "warning: '$key' is running but announced no bridge within 20s — '$PROG status $key'"
  fi
}

# Rotate every enabled topic. This is what claude-topic-rotate-on-boot.service runs.
#
# WHY UNCONDITIONAL, and not "rotate only the broken ones". A dead bridge is not observable
# from this host: every local signal — the session file, the transcript's bridge_status line —
# records what the session ANNOUNCED, not what the server honours. A check built on them
# reports green for exactly the failure it claims to catch, which is why three monitoring
# layers stayed green through the 2026-08-06 outage with eleven of twelve topics unreachable.
# See decisions/2026-08-06-remote-control-bridge-dies-with-the-conversation.md, decision #3.
#
# So this does not try to observe. A NEW conversation always mints a live bridge, so rotating
# everything is correct by construction — no check, therefore no false green. Boot is the one
# moment it is cheap: nothing is mid-task, the processes have only just started.
#
# What it costs: every topic comes back with empty context. What it does NOT cost: history.
# cmd_rotate records each abandoned sessionId to $ROTATED before discarding anything and
# refuses to proceed if it cannot, and transcripts are never deleted. This additionally writes
# a per-boot digest so "what was I working on, and where is it now" is one file to read
# instead of a grep across an append-only log.
#
# Only ENABLED units are touched: `stop` disables deliberately, and a topic someone stopped on
# purpose must not be resurrected by a reboot.
cmd_rotate_all() {
  local dry=0
  # Reject unknown arguments. This accepted ONLY the exact string --dry-run and fell through to
  # the destructive path for anything else: --dryrun, --dry, -n, or a stray key would blank every
  # conversation on the box. A typo must not be a fleet-wide rotate.
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      *) die "rotate-all takes no arguments except --dry-run (got '$1')" ;;
    esac
    shift
  done
  require_systemd; require_registry
  local digest="${STATE_DIR}/last-boot-rotation.tsv"
  local k name old new rc total=0 done=0 failed=0

  for k in $(all_keys); do
    systemctl --user is-enabled --quiet "$(svc "$k")" 2>/dev/null || continue
    total=$((total + 1))
  done
  [ "$total" -gt 0 ] || { err "no enabled topics to rotate"; return 0; }

  if [ "$dry" = 1 ]; then
    printf '%-18s %-38s %s\n' KEY 'SESSIONID THAT WOULD BE ABANDONED' NAME
    for k in $(all_keys); do
      systemctl --user is-enabled --quiet "$(svc "$k")" 2>/dev/null || continue
      old="$(sid_to_abandon "$k")"; [ -n "$old" ] || old='<none — plain fresh start>'
      printf '%-18s %-38s %s\n' "$k" "$old" "$(reg_name "$k")"
    done
    err "dry run: nothing was changed. $total topic(s) would be rotated."
    return 0
  fi

  umask 077
  : > "$digest" || die "could not write $digest — refusing to rotate with nowhere to record it"
  printf '# rotated at boot: %s\n# key\tname\tabandoned-sessionId\tnew-url\n' "$(date -Is)" >> "$digest"

  for k in $(all_keys); do
    systemctl --user is-enabled --quiet "$(svc "$k")" 2>/dev/null || continue
    name="$(reg_name "$k")"; [ -n "$name" ] || name="$k"
    old="$(sid_to_abandon "$k")"; [ -n "$old" ] || old='-'
    # Subshell: a die() inside cmd_rotate must not abandon the remaining topics half-done.
    # It MUST be the condition of an `if`. `( cmd_rotate "$k" ); rc=$?` does NOT work: under
    # `set -e` the failing subshell is a simple command in ordinary position, so errexit fires
    # and kills the whole loop before `rc=$?` ever runs — the exact opposite of what the comment
    # above promised, on the path that runs at boot for every agent. Proved with a fixture:
    # a three-item loop processed one item and exited 1.
    if ( cmd_rotate "$k" ) >/dev/null 2>&1; then rc=0; else rc=$?; fi
    if [ "$rc" -eq 0 ]; then done=$((done + 1)); else failed=$((failed + 1)); fi
    new="$(bridge_id_live "$k")"
    if [ -n "$new" ]; then new="https://claude.ai/code/$new"
    else new='<no bridge announced>'; fi
    printf '%s\t%s\t%s\t%s\n' "$k" "$name" "$old" "$new" >> "$digest"
  done

  err "rotated $done/$total topic(s), $failed failed. Digest: $digest
  The new URLs there are what the session ANNOUNCED — opening one is still the only proof."
  [ "$failed" -eq 0 ]
}

cmd_new() {
  local key="$1" name="$2" existing sid
  require_valid_key "$key"; require_systemd
  [ -n "$name" ] || die "empty display name"
  case "$name" in *$'\t'*) die "display name may not contain a tab (the registry is TSV)" ;; esac
  # Newline/CR would write a SECOND row into the TSV (row injection: the injected line can be a
  # perfectly valid key+name that later tooling trusts). The registry is line-oriented; the name
  # must stay one line.
  case "$name" in *$'\n'*|*$'\r'*) die "display name may not contain a newline" ;; esac
  require_safe_value "display name" "$name"
  [ -n "$AGENT_REPO" ] || die "no agent repo found under $HOME_DIR/github/<org> (expected kb-agent-<role>-<name>/)"
  existing="$(reg_name "$key")"
  [ -z "$existing" ] || [ "$existing" = "$name" ] || \
    die "'$key' is already registered as \"$existing\" — pick another key, or edit $REG to rename it"
  if [ "$(svc_state "$key")" = active ]; then die "topic '$key' is already running — use '$PROG restart $key'"; fi
  sid="$(state_sid "$key")"
  local inherited_sid="$sid"        # remember whether the sessionId predates this invocation
  [ -z "$sid" ] || err "note: '$key' has a stored sessionId ($sid) — it will RESUME that conversation, not start a blank one"

  # The row must exist BEFORE the unit starts — claude-topic@.service resolves the display name
  # from the registry at startup — so it cannot simply be written after success. But a failed start
  # then used to leave the row behind, uncommitted: an orphan entry for a topic that does not run,
  # which agentic-monitor reports as down and which leaves the brain repo dirty. A dirty worktree
  # makes kb-sync's `pull --ff-only` fail for that clone as soon as origin touches the same file,
  # on a log line nobody reads. So: remember whether WE added it, and roll back on every failure
  # path. `added` is 0 when the key was already registered with this same display name (reg_add is
  # a no-op then) — rolling back in that case would delete a pre-existing topic.
  local added=0
  [ -n "$existing" ] || added=1
  new_fail() {  # new_fail <message> — undo our own half-built topic, then die
    # Undo BOTH sides. Removing only the registry row would leave the opposite orphan — an enabled
    # unit with no registry entry — and agentic-monitor deliberately skips topics that aren't
    # enabled, so it reports nothing either way. Leave the box in the state it was in before.
    systemctl --user disable --now "$(svc "$key")" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$(svc "$key")" >/dev/null 2>&1 || true
    # And the sessionId: `save_sid` runs before the final active check, so without this a failed
    # `new` left a stored sessionId for a key with no registry row — a third orphan, and one no
    # check can see because topics.state is deliberately not versioned. Only clear it if we did not
    # inherit it: a pre-existing sessionId belongs to an earlier conversation and is the thing a
    # later `new`/`restart` is meant to resume.
    [ -n "$inherited_sid" ] || del_sid "$key"
    [ "$added" = 1 ] && reg_del "$key"
    die "$*"
  }
  reg_add "$key" "$name"
  systemctl --user reset-failed "$(svc "$key")" 2>/dev/null || true
  systemctl --user enable --now "$(svc "$key")" || \
    new_fail "failed to start $(svc "$key") — journalctl --user -u $(svc "$key") -n 50"
  # Capture the sessionId claude just created so future restarts --resume it.
  sid="$(wait_session_id "$key")"
  if [ -n "$sid" ]; then save_sid "$key" "$sid"; else
    err "warning: no sessionId visible after 15s — run '$PROG remember $key' once it registers"
  fi
  [ "$(svc_state "$key")" = active ] || \
    new_fail "'$key' is '$(svc_state "$key")' after start — journalctl --user -u $(svc "$key") -n 50"
  reg_commit register "$key"
  echo "started '$key' (\"$name\") under systemd; sessionId: ${sid:-<pending>}"
}

cmd_restart() {
  local key="" allow_new=0 stored live got st
  while [ $# -gt 0 ]; do
    case "$1" in
      --new) allow_new=1 ;;
      -*)    die "unknown flag '$1' for restart" ;;
      *)     [ -z "$key" ] || die "restart takes one key (got '$key' and '$1')"; key="$1" ;;
    esac
    shift
  done
  [ -n "$key" ] || { usage; exit 2; }
  require_valid_key "$key"; require_systemd; require_registry; require_known_key "$key"

  # Without a display name, `run` exits 1 and Restart=always fail-loops the unit.
  [ -n "$(reg_name "$key")" ] || \
    die "'$key' has no display name in $REG — refusing to restart (the service would fail-loop)"

  stored="$(state_sid "$key")"
  if [ "$allow_new" = 1 ]; then
    # --new means "start fresh": clear the stored id, or `run` would resume it anyway.
    [ -z "$stored" ] || err "warning: discarding stored sessionId $stored for '$key' (--new)"
    del_sid "$key"; stored=""
    err "warning: '$key' will start a NEW conversation — prior history stays on disk but is no longer resumed"
  else
    # Read the LIVE id first, always. The stored one is written at create/restart/remember and at no
    # other time, but the running conversation's id can change underneath it — a compaction, a slash
    # command, a new chat started in the app. From that moment state is stale and silent, and the next
    # restart resumes the OLD branch, orphaning everything said since. That is exactly what happened on
    # 2026-08-27: state said 67de1312, the live conversation was cd4f4314, and the 2026-08-30 restart
    # jumped back three days. Nothing was lost, but neither Durin nor Dario could see the split from
    # inside — the restart reported success, because by its own definition it had succeeded.
    live="$(session_id_live "$key")"
    if [ -z "$stored" ]; then
      [ -n "$live" ] || die "no stored or live sessionId for '$key' — a restart would start a BLANK conversation
  and orphan its history (incident 2026-07-17). Re-run with '$PROG restart --new $key' if that is what you want."
      save_sid "$key" "$live"; stored="$live"
      err "note: no sessionId was stored for '$key' — captured the live one ($live) before restarting"
    elif [ -n "$live" ] && [ "$live" != "$stored" ]; then
      # Adopt the live one: it is the conversation actually in progress, and the whole point of
      # `restart` is to bring back the conversation the user is having, not the one state remembers.
      save_sid "$key" "$live"
      err "note: '$key' had drifted — state recorded $stored but the live conversation is $live."
      err "      Adopting the live one, so the restart resumes what you are actually talking to."
      err "      The $stored branch stays on disk; nothing is lost."
      stored="$live"
    fi
    require_uuid "stored sessionId" "$stored"
    transcript_exists "$stored" || die \
      "stored sessionId $stored for '$key' has no conversation on disk ($PROJ_DIR/*/$stored.jsonl).
  'claude --resume' would fail and systemd would fail-loop the topic into 'failed'. If it was just
  created, wait for it to write its transcript; otherwise start over with '$PROG restart --new $key'."
  fi

  systemctl --user restart "$(svc "$key")" || die "systemctl restart failed for $(svc "$key")"
  got="$(wait_session_id "$key")"
  st="$(svc_state "$key")"
  [ "$st" = active ] || die "'$key' is '$st' after restart — journalctl --user -u $(svc "$key") -n 50"
  # A restart of a stopped (hence disabled) topic starts it without re-enabling: it would
  # run now and be gone after the next reboot, and agentic-monitor only checks is-active.
  # `restart` is the "make this topic run" verb, so restore the reboot invariant.
  if [ "$(systemctl --user is-enabled "$(svc "$key")" 2>/dev/null || true)" != enabled ]; then
    systemctl --user enable "$(svc "$key")" >/dev/null 2>&1 \
      && err "note: '$key' was disabled — re-enabled so it survives a reboot" \
      || err "warning: '$key' is running but NOT enabled — it will not come back after a reboot"
  fi
  if [ -z "$got" ]; then
    err "warning: '$key' is active but reported no sessionId within 15s — check '$PROG status $key'"
  elif [ -z "$stored" ]; then
    # Came up with --new: persist the conversation it just created, otherwise the next
    # restart has nothing to resume and blanks it again.
    save_sid "$key" "$got"
    err "note: recorded new sessionId $got for '$key' — future restarts will resume it"
  elif [ "$got" != "$stored" ]; then
    err "warning: '$key' resumed $got but $stored was stored — the conversation may have changed"
  fi
  echo "restarted '$key' (\"$(reg_name "$key")\"); sessionId: ${got:-<pending>}"
}

cmd_stop() {
  local key="$1" before sid
  require_valid_key "$key"; require_systemd
  if ! unit_known "$key"; then
    # Distinguish "registered but not running" from "no such topic at all" — after a
    # `stop` the unit is unloaded, so both would otherwise report the same thing.
    reg_has "$key" && die "'$key' is registered but not running (not-started) — nothing to stop"
    die "unknown topic '$key' — no claude-topic@$key service and no entry in $REG.
  Known topics: $(all_keys | paste -sd' ' - || true)"
  fi
  before="$(svc_state "$key")"
  [ "$before" = active ] || err "note: '$key' was already '$before'"
  # Record the live sessionId first, so this topic can be resumed rather than restarted blank.
  sid="$(session_id_live "$key")"
  if [ -n "$sid" ] && [ "$sid" != "$(state_sid "$key")" ]; then
    save_sid "$key" "$sid"; err "note: recorded live sessionId $sid before stopping"
  fi
  systemctl --user disable --now "$(svc "$key")" >/dev/null 2>&1 || \
    die "failed to stop/disable $(svc "$key") — journalctl --user -u $(svc "$key") -n 50"
  local kept; kept="$(state_sid "$key")"
  echo "stopped and disabled '$key' — it will NOT return at boot; '$PROG restart $key' resumes sessionId ${kept:-<none>}"
}

# Fully forget a topic: unregister from topics.tsv + clear its saved sessionId + disable the unit.
# Use this (not just `stop`) when a topic is gone for good — otherwise it lingers in the registry
# and agentic-monitor keeps reporting it as "down". `stop` keeps it for later; `remove` deletes it.
cmd_remove() {
  local key="$1"
  require_valid_key "$key"; require_systemd
  reg_has "$key" || unit_known "$key" || die "unknown topic '$key' — nothing to remove.
  Known topics: $(all_keys | paste -sd' ' - || true)"
  # Record the pointer before discarding it. `rotate` refuses to abandon an id it cannot write
  # down; `remove` used to drop one in silence, leaving a transcript on disk that nothing on the
  # box could name afterwards. Same append, same file, same reason.
  local gone; gone="$(sid_to_abandon "$key")"
  if [ -n "$gone" ]; then
    umask 077
    printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "$key" "$gone" "removed:$(reg_name "$key")" >> "$ROTATED" \
      || die "could not append to $ROTATED — refusing to remove '$key' with no record of $gone"
    err "note: recorded $gone for '$key' in $ROTATED before removing — its transcript stays on disk"
  fi
  systemctl --user disable --now "$(svc "$key")" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$(svc "$key")" >/dev/null 2>&1 || true
  reg_del "$key"; del_sid "$key"
  reg_commit remove "$key"
  echo "removed '$key' — unregistered from ${REG##*/}, cleared state, unit disabled. Gone for good."
}

cmd_remember() {
  local key="$1" sid
  require_valid_key "$key"; require_systemd; require_known_key "$key"
  [ "$(svc_state "$key")" = active ] || die "'$key' is not running ($(svc_state "$key")) — nothing live to remember"
  sid="$(session_id_live "$key")"
  [ -n "$sid" ] || die "'$key' is running but has not written a session file yet — retry in a few seconds"
  save_sid "$key" "$sid"; echo "remembered '$key' -> $sid"
}

# Foreground launcher for the systemd unit: resolve name + sessionId, exec claude.
# Diagnostics go to stderr, i.e. the journal — this runs unattended under systemd.
cmd_run() {
  local key="$1" name sid
  require_valid_key "$key"; require_registry
  name="$(reg_name "$key")"; [ -n "$name" ] || die "no display name for '$key' in $REG"
  require_safe_value "display name" "$name"
  command -v claude >/dev/null 2>&1 || die "claude not found in PATH ($PATH)"
  sid="$(state_sid "$key")"
  # THE UNATTENDED PATH. systemd re-runs this on every crash (Restart=always), and it used to
  # resume the stored pointer without question. That is where the damage happened: the runtime
  # re-keys the sessionId on /clear and on compaction without telling anyone, so a stored pointer
  # can be days stale, and this exec is the moment it becomes a lost conversation. The adoption
  # logic first lived only in `restart` — the one path with a human watching — which is exactly
  # backwards. Reconstructed against the real incidents: at both the 2026-08-25 and 2026-08-30
  # restarts the derivation below returns the branch that was actually live, where stored returned
  # a pointer frozen since 2026-08-06.
  #
  # Derive from DISK, not from the live process: at this point nothing is running (we are about to
  # exec it), and the session file the live-poll reads dies with the process it describes.
  if [ -n "$sid" ]; then
    require_uuid "stored sessionId" "$sid"
    local _br _newest
    _br="$(bridge_of_sid "$sid")"
    _newest="$(sid_newest_on_bridge "$_br")"
    if [ -n "$_newest" ] && [ "$_newest" != "$sid" ] && transcript_exists "$_newest"; then
      err "note: '$key' had drifted — state recorded $sid, but the newest conversation on its"
      err "      Remote Control bridge is $_newest. Resuming that instead; $sid stays on disk."
      printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "$key" "$sid" "superseded-by:$_newest" >> "$ROTATED" 2>/dev/null || true
      save_sid "$key" "$_newest"
      sid="$_newest"
    fi
    # claude's own failure here is ANSI-mangled in the journal; log the cause in plain text.
    transcript_exists "$sid" || err \
      "warning: no transcript for sessionId $sid — 'claude --resume' will likely fail and this unit will fail-loop; fix with '$PROG restart --new $key'"
    exec claude --resume "$sid" --remote-control "$name"
  else
    err "no stored sessionId for '$key' — starting a NEW conversation"
    exec claude --remote-control "$name"
  fi
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  local cmd="$1"; shift
  case "$cmd" in
    list)             cmd_list ;;
    urls)             cmd_urls ;;
    rotate)           [ $# -ge 1 ] || { usage; exit 2; }; cmd_rotate "$1" ;;
    rotate-all)       cmd_rotate_all "$@" ;;
    status)           [ $# -ge 1 ] || { usage; exit 2; }; cmd_status "$@" ;;
    new)              [ $# -ge 2 ] || { usage; exit 2; }; cmd_new "$1" "$2" ;;
    restart)          [ $# -ge 1 ] || { usage; exit 2; }; cmd_restart "$@" ;;
    stop)             [ $# -ge 1 ] || { usage; exit 2; }; cmd_stop "$1" ;;
    remove)           [ $# -ge 1 ] || { usage; exit 2; }; cmd_remove "$1" ;;
    remember)         [ $# -ge 1 ] || { usage; exit 2; }; cmd_remember "$1" ;;
    run)              [ $# -ge 1 ] || { usage; exit 2; }; cmd_run "$1" ;;
    help|-h|--help)   usage ;;
    *)                err "unknown command '$cmd'"; usage; exit 2 ;;
  esac
}
main "$@"
