# Nightly memory consolidation ("dreaming") for one agent — %i is the agent Unix user.
#
# Runs the root-owned /usr/local/bin/dream, which mirrors the agent's runtime auto-memory
# into its brain repo (deterministic) and then runs a tightly-scoped headless `claude -p`
# distillation that may write ONLY within memory/ (the wrapper reverts anything else).
# Capability/identity changes never happen here — only via the human-run `agent-audit` skill.
#
# Triggered by dream@%i.timer (DISABLED by default; opt-in per agent). Canonical: Valiant-Codex/infra.
[Unit]
Description=Nightly memory consolidation (dreaming) for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dream %i --distill
TimeoutStartSec=1800
