# Nightly memory consolidation ("dreaming") for one agent — %i is the agent Unix user.
#
# Runs the root-owned /usr/local/bin/dream in MIRROR-ONLY mode: it copies the agent's runtime
# auto-memory into its brain repo (deterministic, no model involved) and commits.
#
# The optional LLM distillation (`dream <user> --distill`) is deliberately NOT wired here.
# Cost/benefit review (2026-07-25): its value rested on a single manual run while it needed
# three supervising mechanisms, three same-day bug fixes, and vendor-specific CLI flags.
# Distillation is done instead by the human-run `agent-audit` skill, where a person sees the
# diff. To trial it again: run `dream <user> --distill` by hand, or add the flag back here.
#
# Triggered by dream@%i.timer (DISABLED by default; opt-in per agent). 
[Unit]
Description=Nightly memory consolidation (dreaming) for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dream %i
TimeoutStartSec=1800
