# Fleet brain divergence check (drift detector, security review F12) + daily update-availability
# report (folded in from the former agentic-update-check timer, 2026-07-27).
# Read-only; exits non-zero when there's something to look at, so the unit surfaces as failed —
# but see SuccessExitStatus below. Canonical source: <ORG>/infra.
[Unit]
Description=Fleet brain divergence check (drift detector) + update-availability report
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/agentic-divergence-check
# Drift/updates (exit 1) must NOT mark the unit failed: agentic-monitor pages on failed units, and
# neither a stale doc link nor a pending apt update should page anyone — nor leave a sticky failed
# state until reset-failed. The script's own healthchecks.io ping (UPDATE_HC_URL) is the alarm path
# for both concerns; a systemd-failed unit (any other non-zero exit) means the checker itself broke.
SuccessExitStatus=1
