# agentic-monitor config — copy to /etc/agentic-monitor.env (mode 600) and set HC_URL.
# HC_URL is a capability (secret-ish): the healthchecks.io ping URL. NEVER commit the real value.
HC_URL=
DISK_MAX=90
# space-separated substring excludes for known noise:
MONITOR_EXCLUDE_CONTAINERS=""
MONITOR_EXCLUDE_UNITS="cloud-init-hotplugd.service"
# critical containers that must be running (substring match) — catches exited/missing (e.g. traefik):
MONITOR_EXPECT_CONTAINERS="dokploy-traefik dokploy-postgres dokploy-redis dokploy.1"
# HTTP liveness (alarm only if NO response) — catches "up but broken" reverse proxy:
MONITOR_HTTP_CHECKS="traefik=http://localhost:80 dokploy=http://localhost:3000"
# Alarm below this % of available memory. Keep it well above single digits: at 5% the host
# is already swap-thrashing and the check may not survive long enough to send the ping.
MONITOR_MEM_MIN_PCT=15
# daily divergence + update report (agentic-divergence-check) — a SEPARATE healthchecks.io check:
UPDATE_HC_URL=
