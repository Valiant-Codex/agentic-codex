# Claude Code Remote Control topic — resilient systemd USER unit (agent-agnostic).
#
# `%i` is the topic key. ExecStart runs the root-owned wrapper `/usr/local/bin/claude-topic
# run %i`, which resolves the display name from the agent's own deploy/topics.tsv and
# the resume sessionId from ~/.config/agent/topics.state, then execs
# `claude --resume <id> --remote-control '<Name>'` in the foreground.
#
# Canonical source: <ORG>/infra (bin/claude-topic + systemd/claude-topic@.service).
# The wrapper is installed to /usr/local/bin/claude-topic (root-owned, 0755) so no agent
# can rewrite what another agent executes — it is NOT carried in kb-agent-shared and
# NOT touched by kb-sync. See the Agentic Codex docs (config-model.md, the provisioning security boundary).
#
# Under systemd, sessions survive crashes (Restart=always) and reboot (user service
# + `loginctl enable-linger <agent>`) with no tmux — Remote Control is the access path.
#
# WHAT Restart=always DOES NOT BUY YOU (2026-08-06). It keeps the PROCESS alive. It does
# not keep the topic REACHABLE. The Remote Control bridge id is derived from the resumed
# conversation, so a restart re-announces the same bridge id; if the server has dropped
# that bridge — a hard reboot did, for eleven of twelve topics — the session announces a
# dead id, logs "/remote-control is active" to its own transcript, and is unreachable
# forever while this unit reports active and enabled. Every automated signal stayed green
# through a total outage. The recovery is a NEW conversation: `claude-topic rotate <key>`.
# After any hard reboot, run `claude-topic urls` and actually open them.
#
# Install: `provision-agent <unix-user> <brain-repo>` does all of it (wrapper, this unit, linger,
# topics, roster, memory mirror) and is the ONLY supported way. This comment used to spell out the
# steps by hand, starting with `sudo install … /usr/local/bin/claude-topic` addressed to the agent's
# own user — i.e. it told an unprivileged agent to root-install the binary every OTHER agent
# executes, from its own clone, with none of the dirty/unpushed/roster guards. That is exactly the
# channel the three-tier config model exists to forbid, and this file is copied into every agent's
# home, so the instruction shipped to all of them. Removed 2026-08-02; use provision-agent.

[Unit]
Description=Claude Code Remote Control topic %i
# NO After=network-online.target here: this is a USER unit, and the user manager has no
# network-online.target (verified: `systemctl --user list-units network-online.target` -> not-found),
# so that dependency was a silent no-op. At boot this unit may start before the network is up; the
# restart policy below is what actually absorbs that.
# NO start limit: with the old StartLimitIntervalSec=60/Burst=5, five fast failures (e.g. claude
# exiting quickly while the network is still down at boot) parked the unit in 'failed' until a human
# ran reset-failed — on a box whose whole point is unattended recovery. A permanently-broken topic
# (bad sessionId) now flaps forever instead, which is fine: `claude-topic run` dies fast and loudly
# before exec in that case, and agentic-monitor's topics-down check pages on any enabled-but-not-
# active topic within two cycles. An infinite retry every 10s is noise in the journal, not damage;
# a unit stuck in 'failed' after a reboot is an outage.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
# systemd's default PATH lacks ~/.local/bin (claude) and ~/.local/node/bin (npx, for
# MCP servers) — set it so `topic run` can exec them. /usr/local/bin holds the wrapper.
Environment=PATH=%h/.local/bin:%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
# claude is a TUI: without a pty it falls into non-interactive --print mode and exits.
# `script` allocates a pty and stays in the foreground so systemd supervises claude
# directly (Restart=always works). The wrapper is the root-owned /usr/local/bin/claude-topic.
# NO Environment=TOPIC_KEY=%i HERE, AND DO NOT PUT IT BACK. It was added on 2026-08-30 so the
# SessionStart hook could know which topic it belonged to, and it was wrong in both directions.
# Absent when needed: the twelve running services were never restarted after the line was added,
# so every SessionStart refused and the mechanism was inert on 12 of 12 topics while being
# reported as verified. Present when not wanted, which is the dangerous half: a systemd
# Environment= is inherited by the WHOLE process tree, so any nested `claude` — a tool call, a
# script, a manual --resume — would fire SessionStart carrying this topic's key and a foreign
# session id, and the hook would write that foreign id into topics.state. It happened before
# anyone noticed: 2026-08-30 14:24:09, a plain `claude` with cwd /tmp and no bridge at all wrote
# `hooktest -> 12163b9a…`. The hook now derives the topic from the Remote Control bridge in its
# own transcript instead, which cannot name a session that is not on that bridge.
ExecStart=/usr/bin/script -qfec "/usr/local/bin/claude-topic run %i" /dev/null
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
